{
  "name": "@open-wa/integration-jev",
  "version": "5.7.0",
  "description": "Jev decision routing and WhatsApp chat actions, shared with Voxtral",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    },
    "./agent": {
      "bun": "./src/agent.ts",
      "import": "./dist/agent.mjs",
      "require": "./dist/agent.cjs",
      "types": "./dist/agent.d.mts"
    }
  },
  "files": [
    "dist",
    "src/dashboard.js",
    "src/chat.js"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/agent.ts --format esm --format cjs --dts",
    "dev": "tsdown src/index.ts src/agent.ts --format esm --format cjs --watch"
  },
  "dependencies": {
    "@open-wa/plugin-sdk": "workspace:*",
    "@open-wa/schema": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.mts"
      },
      "./agent": {
        "import": "./dist/agent.mjs",
        "require": "./dist/agent.cjs",
        "types": "./dist/agent.d.mts"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-wa/wa-automate-nodejs.git"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
