{
  "name": "@open-wa/driver-lightpanda",
  "version": "5.3.0",
  "description": "Lightpanda browser driver for open-wa",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs",
    "dev": "tsdown src/index.ts --format cjs --watch",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-wa/driver-interface": "workspace:*",
    "effect": "catalog:",
    "fflate": "^0.8.3",
    "proper-lockfile": "^4.1.2",
    "proxy-agent": "^8.0.1",
    "puppeteer-core": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-wa/wa-automate-nodejs.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ]
}
