{
  "name": "@open-wa/mcp",
  "version": "5.9.0",
  "type": "module",
  "description": "MCP server integration for open-wa",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-wa/config": "workspace:*",
    "@open-wa/schema": "workspace:*",
    "@open-wa/utils": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:",
    "@modelcontextprotocol/server": "2.3.1",
    "@open-wa/runtime-core": "workspace:*",
    "standardwebhooks": "1.0.0",
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        },
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-wa/wa-automate-nodejs.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ]
}
