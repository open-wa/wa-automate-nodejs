{
  "name": "@open-wa/config",
  "version": "5.4.0",
  "description": "Configuration management for open-wa - schemas, loading, merging, and validation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "bun": "./src/schema/index.ts",
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs",
      "require": "./dist/schema.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit",
    "generate:schema": "tsx scripts/generate-json-schema.ts",
    "generate:config-reference": "tsx scripts/gen-config-reference.ts",
    "generate": "tsx scripts/generate-json-schema.ts && tsx scripts/gen-config-reference.ts"
  },
  "dependencies": {
    "cosmiconfig": "^10.0.1",
    "cosmiconfig-typescript-loader": "^6.3.0",
    "deepmerge-ts": "^8.0.2",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./schema": {
        "types": "./dist/schema.d.mts",
        "import": "./dist/schema.mjs",
        "require": "./dist/schema.cjs"
      }
    }
  },
  "keywords": [
    "open-wa",
    "whatsapp",
    "config",
    "configuration",
    "zod",
    "cosmiconfig"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/open-wa/wa-automate-nodejs.git"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
