{
  "name": "@open-wa/hyperemitter",
  "version": "5.9.2",
  "description": "HyperEmitter: high-performance, schema-driven event emitter for the open-wa v5 stack.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs",
    "dev": "tsdown src/index.ts --format esm --format cjs --watch",
    "lint": "oxlint src",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "bench:baseline": "node benchmarks/baseline/run-baseline.js",
    "bench:effect": "node --expose-gc benchmarks/run-effect.mjs",
    "bench:baseline:ci": "node benchmarks/baseline/run-baseline.js --ci",
    "bench:pubsub": "node --expose-gc benchmarks/run-pubsub.mjs",
    "check:public-events": "node checks/public-api.mjs"
  },
  "keywords": [
    "eventemitter",
    "events",
    "pubsub",
    "hyperemitter",
    "open-wa"
  ],
  "author": "open-wa",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.mts"
      }
    }
  },
  "dependencies": {
    "@open-wa/logger": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "emittery": "^2.1.0",
    "eventemitter3": "^5.0.4",
    "mitt": "^3.0.1",
    "tseep": "^1.3.1",
    "typescript": "catalog:"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/open-wa/wa-automate-nodejs.git"
  }
}
