{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openwa-docs",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "run_worker_first": ["/", "/docs", "/docs/*", "/changelog", "/changelog/*", "/blog", "/blog/*"],
  },
  "services": [{ "binding": "OPENWA_CMS", "service": "openwa-cms" }],
  "observability": {
    "enabled": true,
  },
}
