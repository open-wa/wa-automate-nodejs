---
import Page from "../layouts/Page.astro";
import { commands } from "../data/facts";
const base = import.meta.env.BASE_URL.replace(/\/?$/u, "/");
---

<Page title="Page not found | open-wa" description="This page doesn't exist. Start from the quick start, the docs or the home page.">
  <section class="section nf">
    <div class="wrap">
      <p class="code404">404</p>
      <h1>This page isn't here</h1>
      <p class="lead">The link may be old. Most people are looking for one of these:</p>
      <div class="btn-row">
        <a class="btn btn--dark" href={`${base}quickstart/`}>Quick start</a>
        <a class="btn btn--ghost" href={`${base}pricing/`}>Pricing</a>
        <a class="btn btn--ghost" href={base}>Home</a>
      </div>
      <p class="muted small">Or just run <code>{commands.easyApi}</code>.</p>
    </div>
  </section>
</Page>

<style>
  .nf .wrap { display: grid; gap: 18px; justify-items: start; }
  .code404 { font: 700 1rem/1 var(--font-mono); background: var(--sun); padding: 6px 10px; border-radius: 6px; }
</style>
