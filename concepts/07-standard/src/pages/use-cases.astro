---
import Page from "../layouts/Page.astro";
import { useCases } from "../data/facts";

const base = import.meta.env.BASE_URL.replace(/\/?$/u, "/");
// Each use case from the fact pack, with the path and methods it uses.
const detail = [
  { path: "SocketClient or the Chatwoot plugin", pathHref: "integrations/#chatwoot", methods: ["onMessage", "sendText"], tier: "Free" },
  { path: "Easy API over HTTP", pathHref: "quickstart/", methods: ["POST /api/messages/sendText"], tier: "Free for existing contacts; Restricted to message new numbers" },
  { path: "SocketClient or the embedded runtime", pathHref: "quickstart/#socket-client", methods: ["onMessage", "onEventResponse", "sendText"], tier: "Free" },
  { path: "Webhook plugin or Node-RED", pathHref: "integrations/#webhooks", methods: ["@open-wa/integration-webhook", "@open-wa/node-red"], tier: "Free" },
  { path: "Named sessions with --session-id", pathHref: "features/#multi-session", methods: ["--session-id", "sessionId"], tier: "Free; keys are per number" },
  { path: "The built-in MCP server", pathHref: "ai-agents/", methods: ["/mcp"], tier: "Follows each method's tier" },
];
---

<Page title="Use cases: what developers build with open-wa" description="Support inboxes, order and delivery notifications, bots, webhook bridges, multi-session automations and AI-agent workflows, each with the path and methods it uses.">
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href={base}>Home</a> / Use cases</p>
      <h1>What you can build on your own number</h1>
      <p>Six common jobs, with the path that fits and the methods each one calls.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <ol class="uc">
        {useCases.map((u, i) => (
          <li>
            <span class="ucn" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h2>{u}</h2>
            <dl>
              <div><dt>Path</dt><dd><a class="link" href={`${base}${detail[i].pathHref}`}>{detail[i].path}</a></dd></div>
              <div><dt>Uses</dt><dd class="ucm">{detail[i].methods.map((m) => <code>{m}</code>)}</dd></div>
              <div><dt>Licence</dt><dd>{detail[i].tier}</dd></div>
            </dl>
          </li>
        ))}
      </ol>
      <p class="more">Want one of these built for you? <a class="link" href={`${base}support/`}>Tell us what you need</a>.</p>
    </div>
  </section>
</Page>

<style>
  .uc { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 900px) { .uc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .uc li { display: grid; gap: 14px; align-content: start; padding: 26px; border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .ucn { font: 600 0.9375rem/1 var(--font-mono); color: var(--sun-ink); }
  .uc h2 { font-size: 1.375rem; line-height: 1.3; }
  .uc dl { margin: 0; display: grid; gap: 8px; }
  .uc dl div { display: grid; grid-template-columns: 80px 1fr; gap: 12px; }
  .uc dt { color: var(--color-muted); }
  .uc dd { margin: 0; }
  .ucm { display: flex; flex-wrap: wrap; gap: 6px; }
  .more { margin-top: 32px; }
</style>
