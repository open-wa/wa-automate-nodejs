---
import Page from "../layouts/Page.astro";
import PricingTable from "../components/PricingTable.astro";
import LicenceForm from "../components/LicenceForm.astro";
import Faq from "../components/Faq.astro";
import { licences, product, commands, support } from "../data/facts";

const base = import.meta.env.BASE_URL.replace(/\/?$/u, "/");
const faqs = [
  { q: "Do I need a licence to use open-wa?", a: "No. The library is free to use, and most methods need no key: reading chats, sending to existing contacts, media, polls, events, webhooks and MCP for those methods. You only need a key when your workflow calls a method marked Insiders or Restricted." },
  { q: "How do I know which tier a method needs?", a: "Method metadata marks each method none, insiders or restricted, and the API docs show it. If a call fails with a licence message, the tier is the one that method is marked with. For example, createGroup is Restricted." },
  { q: "What does \"per WhatsApp number\" mean?", a: "A key is tied to the WhatsApp account it was bought for. If you run two numbers that both need licensed methods, you need two keys." },
  { q: "How do I add the key?", a: `Pass it at launch with ${commands.licenceFlag}, or set licenseKey in your config. From 5.5 you can also apply it from the dashboard or with client.refresh() without restarting the Node process.` },
  { q: "Does a licence lower the risk of a ban?", a: `No. ${product.risk} A key unlocks methods; it changes nothing about how WhatsApp treats the account.` },
  { q: "Are the prices current?", a: `They were ${licences.pricesCheckedOn.charAt(0).toLowerCase()}${licences.pricesCheckedOn.slice(1)}` },
  { q: "Can I get help choosing or setting up?", a: "Yes. Ask in Discord, or book paid support and consulting from the support page." },
];
---

<Page
  title="Pricing and licence keys | open-wa"
  description="open-wa is free for most methods. Insiders and Restricted keys unlock the rest, per WhatsApp number, from £5 a month. Prices checked 12 Oct 2026."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href={base}>Home</a> / Pricing</p>
      <h1>Free for most methods. Pay per number for the rest.</h1>
      <p>{licences.summary.replace("--license-key or licenseKey", "--license-key or licenseKey")}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <PricingTable ctaBase={`${base}pricing/`} />
    </div>
  </section>

  <section class="section section--tint" id="buy">
    <div class="wrap buy">
      <div class="buy-copy">
        <h2>Get a licence key</h2>
        <p class="lead">Four details, then a prefilled Gumroad checkout where you review the price and pay.</p>
        <h3>Before you buy</h3>
        <ol class="before">
          {licences.beforeYouBuy.map((b) => <li>{b}</li>)}
        </ol>
        <p class="note"><span><strong>A key doesn't change the risk.</strong> {product.risk}</span></p>
        <p class="muted small">Need several numbers, or a hand with the set-up? <a class="link" href={`${base}support/`}>Talk to us about support and consulting</a>.</p>
      </div>
      <LicenceForm />
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <h2>Licence questions</h2>
        <p>Still unsure? Ask in <a class="link" href={support.discord}>Discord</a> or read the <a class="link" href={support.licensingDocs}>licensing docs</a>.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>
</Page>

<style>
  .buy { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 960px) { .buy { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); } }
  .buy-copy { display: grid; gap: 18px; }
  .buy-copy h3 { margin-top: 8px; }
  .before { margin: 0; padding-left: 1.4em; display: grid; gap: 8px; }
  .faq-wrap { max-width: 880px; }
</style>
