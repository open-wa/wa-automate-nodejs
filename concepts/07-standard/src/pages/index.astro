---
import Page from "../layouts/Page.astro";
import QuickStartCard from "../components/QuickStartCard.astro";
import CodeBlock from "../components/CodeBlock.astro";
import PricingTable from "../components/PricingTable.astro";
import CapRow from "../components/CapRow.astro";
import Faq from "../components/Faq.astro";
import { DOCS, product, stats, commands, snippets, paths, releases, support, kDown, checked, curlSend, integrations, useCases, generalFaqs, migration } from "../data/facts";

const base = import.meta.env.BASE_URL.replace(/\/?$/u, "/");
const latest = releases[0];
---

<Page
  title="open-wa: a WhatsApp API on your own number, for Node.js"
  description="One command turns your phone's WhatsApp account into a local HTTP API with interactive docs. Open source, free for most methods, unofficial."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <h1 class="hero-h1">Run a WhatsApp API on your own number</h1>
      <p class="hero-sub">One command turns your phone's WhatsApp account into a local HTTP API for your Node.js app. Open source, and free for most methods.</p>
      <div class="hero-actions btn-row">
        <a class="btn btn--dark" href={`${base}quickstart/`}>Quick start <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={DOCS}>Read the docs</a>
      </div>
      <div class="hero-card">
        <QuickStartCard id="hero-qs" />
        <p class="hero-risk">Unofficial and not affiliated with WhatsApp. Automation can get an account banned: <a class="link" href={`${base}legal/#risk`}>read the risk note</a>.</p>
      </div>
    </div>
  </section>

  <section class="signals" aria-label="Project signals">
    <div class="wrap">
      <ul class="sig">
        <li><strong>v{product.currentVersion}</strong><span>latest on npm, {latest.date}</span></li>
        <li><strong>{kDown(stats.githubStars)}</strong><span>GitHub stars</span></li>
        <li><strong>{kDown(stats.npmDownloadsLast12Months)}</strong><span>npm downloads in 12 months</span></li>
        <li><strong>{kDown(stats.dockerPulls)}</strong><span>Docker pulls</span></li>
        <li><strong>{stats.discordMembers.toLocaleString("en-GB")}</strong><span>Discord members</span></li>
      </ul>
      <p class="sig-note">Public counts from GitHub, npm, Docker Hub and Discord, checked {checked}. Maintained since 2019 by {support.maintainer}.</p>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="section-head">
        <h2>Up and running in three steps</h2>
        <p>No Meta business account, no templates to approve. You need Node.js and the phone with the WhatsApp account you want to use.</p>
      </div>
      <ol class="steps">
        <li class="step">
          <span class="step-n">1</span>
          <h3>Run the command</h3>
          <p>It starts an Easy API instance on the port you choose.</p>
          <CodeBlock code={commands.easyApi} lang="bash" />
        </li>
        <li class="step">
          <span class="step-n">2</span>
          <h3>Link your phone</h3>
          <p>Scan the QR code it prints with WhatsApp on your phone, or log in with a link code.</p>
          <div class="step-art" aria-hidden="true">
            <div class="phone">
              <div class="phone-top"></div>
              <p class="phone-h">Linked devices</p>
              <div class="phone-btn">Link a device</div>
              <div class="phone-row"><i></i><span>open-wa on port 8080</span></div>
            </div>
          </div>
        </li>
        <li class="step">
          <span class="step-n">3</span>
          <h3>Open the API docs</h3>
          <p>Every running instance serves interactive docs, plus Swagger and Postman files.</p>
          <CodeBlock code={commands.proofOfLife} lang="text" title="Browser" />
        </li>
      </ol>
      <div class="how-foot">
        <p class="note"><span><strong>Know the risk before you start.</strong> {product.risk} open-wa is unofficial and isn't affiliated with WhatsApp or Meta.</span></p>
        <a class="btn btn--primary" href={`${base}quickstart/`}>Follow the quick start <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="paths">
    <div class="wrap">
      <div class="section-head">
        <h2>Four ways to connect your code</h2>
        <p>Start with the Easy API, then pick how your app talks to it.</p>
      </div>
      <div class="paths" data-paths>
        <div class="paths-tabs" role="tablist" aria-label="Ways to use open-wa">
          {paths.map((p, i) => (
            <button role="tab" type="button" id={`path-tab-${p.id}`} aria-controls={`path-${p.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <strong>{p.name}</strong><span>{p.for}</span>
            </button>
          ))}
        </div>
        {paths.map((p, i) => (
          <div class="paths-panel" role="tabpanel" id={`path-${p.id}`} aria-labelledby={`path-tab-${p.id}`} hidden={i !== 0}>
            <p>{p.what}</p>
            {p.id === "easy-api" && <CodeBlock code={curlSend} lang="bash" title="Send a message with curl" />}
            {p.id === "socket-client" && <CodeBlock code={snippets.socketClient} lang="js" title="bot.mjs" />}
            {p.id === "embedded" && <CodeBlock code={snippets.embedded} lang="js" title="app.mjs" />}
            {p.id === "mcp" && <CodeBlock code={snippets.mcpConfig} lang="js" title="wa.config.mjs" />}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="capabilities">
    <div class="wrap">
      <div class="section-head">
        <h2>What your code can do with WhatsApp</h2>
        <p>Each capability with the request or call that does it. The full list is on the features page.</p>
      </div>
      <div class="caps">
        <CapRow title="Send and receive messages" text="Text, replies, forwards, reactions and edits. Images, video, documents and voice notes with captions. Listen for incoming messages and answer them." code={snippets.socketClient} codeTitle="bot.mjs" methods={["sendText", "onMessage"]} />
        <CapRow flip title="Native event cards and RSVPs" text="Create, edit and cancel WhatsApp event cards and handle going, not going and maybe. New in 5.5." code={snippets.event} codeTitle="events.mjs" methods={["sendEvent", "onEventResponse"]} />
        <CapRow title="Several numbers side by side" text="Run named sessions on their own ports, each with isolated consumers. Session files are compact, encrypted with your own key, and move between containers." code={commands.namedSession} lang="bash" codeTitle="Terminal" methods={["--session-id"]} />
        <CapRow flip title="Stickers rendered on your machine" text="Turn a photo into a WebP sticker locally with @open-wa/stickers and its 62 recipes." code={commands.stickerCli} lang="bash" codeTitle="Terminal" note="Sending stickers from the client needs a private finalizer; local rendering is open to everyone." />
      </div>
      <p class="more"><a class="link" href={`${base}features/`}>See every capability</a></p>
    </div>
  </section>

  <section class="section section--tint" id="integrations">
    <div class="wrap">
      <div class="section-head">
        <h2>Plugs into the tools you already run</h2>
        <p>Official plugins load with one line in your config. Write your own with the Plugin SDK.</p>
      </div>
      <ul class="integ">
        {integrations.map((it) => (
          <li class="integ-card">
            <span class="integ-pkg">{it.package === "built in" ? "mcp: { enabled: true }" : `'${it.package}'`}</span>
            <h3>{it.name}</h3>
            <p>{it.what}</p>
          </li>
        ))}
      </ul>
      <p class="more"><a class="link" href={`${base}integrations/`}>How each integration works</a></p>
    </div>
  </section>

  <section class="section section--dark" id="mcp">
    <div class="wrap mcp">
      <div class="mcp-copy">
        <span class="kicker">Built-in MCP server</span>
        <h2>Give Claude, Cursor or Windsurf a WhatsApp number</h2>
        <p>Turn on MCP in your config and each Easy API method becomes a tool your agent can call at <code>{commands.mcpEndpoint}</code>.</p>
        <ul class="ticks">
          <li>Tools keep the method's licence rule: free methods are free tools, licensed methods need the key.</li>
          <li>Protect the endpoint with the same API key as the HTTP API.</li>
          <li>Agents such as Claude, Cursor and Windsurf call the tools over HTTP.</li>
        </ul>
        <a class="btn btn--primary" href={`${base}ai-agents/`}>Set up the MCP server <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="mcp-code">
        <CodeBlock code={snippets.mcpConfig} lang="js" title="wa.config.mjs" />
        <CodeBlock code={snippets.claudeDesktop} lang="json" title="Claude Desktop config" />
      </div>
    </div>
  </section>

  <section class="section" id="use-cases">
    <div class="wrap">
      <div class="section-head">
        <h2>What people build with it</h2>
      </div>
      <ul class="uses">
        {useCases.map((u, i) => <li><span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>{u}</li>)}
      </ul>
      <p class="more"><a class="link" href={`${base}use-cases/`}>Use cases with the methods they need</a></p>
    </div>
  </section>

  <section class="section section--tint" id="pricing">
    <div class="wrap">
      <div class="section-head">
        <h2>Free for most methods. A key for the rest.</h2>
        <p>Each method is marked free, Insiders or Restricted. You only need a key, per WhatsApp number, if your workflow calls a licensed method.</p>
      </div>
      <PricingTable />
    </div>
  </section>

  <section class="section" id="status">
    <div class="wrap status">
      <div>
        <h2>Unofficial, maintained, and plain about the risk</h2>
        <p class="lead">Read this before you put a number you care about on it.</p>
      </div>
      <div class="status-grid">
        <div class="card">
          <h3>Unofficial</h3>
          <p>{product.unofficial}</p>
        </div>
        <div class="card">
          <h3>Ban risk</h3>
          <p>{product.risk}</p>
        </div>
        <div class="card">
          <h3>Maintained</h3>
          <p>v{product.currentVersion} is the latest on npm. 5.5.0 ({latest.date}) added {latest.headline.toLowerCase()}. {stats.publishedVersions} versions published since 2020.</p>
          <a class="link" href={`${base}changelog/`}>Changelog</a>
        </div>
        <div class="card">
          <h3>Licence</h3>
          <p>Source under the {product.softwareLicence}. Using the project means you agree to the Terms of Service.</p>
          <a class="link" href={`${base}legal/`}>Legal notices</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="faq">
    <div class="wrap faq-wrap">
      <div class="section-head"><h2>Questions developers ask first</h2></div>
      <Faq items={generalFaqs} />
    </div>
  </section>

  <section class="section routes-sec">
    <div class="wrap routes">
      <div class="route">
        <h3>Building it yourself</h3>
        <p>Run the command, follow the quick start and ask in Discord when you're stuck. {stats.discordMembers.toLocaleString("en-GB")} members, checked {checked}.</p>
        <div class="btn-row">
          <a class="btn btn--dark" href={`${base}quickstart/`}>Quick start</a>
          <a class="btn btn--ghost" href={`${base}migrate/`}>Coming from v4?</a>
        </div>
      </div>
      <div class="route route--biz">
        <h3>Want it built for you</h3>
        <p>Paid support and consulting from the maintainer: by email, per minute, or a booked hour. Or describe the project in a short form.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={`${base}support/`}>Tell us what you need</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark closing">
    <div class="wrap closing-inner">
      <h2>Send your first message today</h2>
      <p>Run it, link your phone, open <code>/api-docs/</code>.</p>
      <div class="closing-cmd">
        <code><span aria-hidden="true">$ </span>{commands.easyApi}</code>
        <button class="copy copy--solid" type="button" data-copy={commands.easyApi} aria-label="Copy the command"><span class="copy-label">Copy</span></button>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={`${base}quickstart/`}>Quick start</a>
        <a class="btn btn--ghost" href={support.discord}>Join the Discord</a>
        <a class="btn btn--ghost" href={support.github}>Star on GitHub</a>
      </div>
    </div>
  </section>
</Page>

<script>
  document.querySelectorAll<HTMLElement>("[data-paths]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute("aria-selected", String(on));
        x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute("aria-controls")!)!.hidden = !on;
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const n = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (n) { e.preventDefault(); select(tabs[(i + n + tabs.length) % tabs.length], true); }
      });
    });
  });
</script>

<style>
  .hero { padding-block: clamp(20px, 6vw, 88px) clamp(48px, 7vw, 96px); background:
    radial-gradient(1200px 400px at 85% -10%, var(--sun-soft), transparent 60%), var(--white); }
  .hero-grid {
    display: grid; gap: 20px 56px; align-items: center;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    grid-template-areas: "h1 card" "sub card" "act card";
    grid-template-rows: auto auto 1fr;
  }
  .hero-h1 { grid-area: h1; align-self: end; max-width: 13ch; }
  .hero-sub { grid-area: sub; font-size: 1.25rem; color: var(--slate-700); max-width: 34ch; }
  .hero-actions { grid-area: act; align-self: start; margin-top: 8px; }
  .hero-card { grid-area: card; min-width: 0; }
  .hero-risk { margin-top: 14px; font-size: var(--text-sm); color: var(--color-muted); }

  @media (max-width: 959px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "h1" "card" "act" "sub"; grid-template-rows: none; gap: 16px; }
    .hero-h1 { max-width: 18ch; font-size: clamp(1.875rem, 1.3rem + 3vw, 3rem); }
    .hero-actions { margin-top: 0; }
    .hero-actions .btn { flex: 1; }
    .hero-risk { display: none; }
  }

  .signals { border-block: 1px solid var(--color-line); background: var(--slate-50); padding-block: 28px; }
  .sig { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px 24px; }
  .sig li { display: grid; gap: 2px; }
  .sig strong { font: 760 1.75rem/1.1 var(--font-display); letter-spacing: -0.02em; }
  .sig span { color: var(--color-muted); font-size: var(--text-sm); }
  .sig-note { margin-top: 16px; font-size: var(--text-sm); color: var(--color-muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 960px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .step { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--white); min-width: 0; }
  .step p { color: var(--slate-700); }
  .step :global(.code) { margin-top: auto; }
  .step-n { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--sun); font: 800 1.0625rem/1 var(--font-mono); }
  .step-art { margin-top: auto; height: 132px; border-radius: var(--radius); background: var(--slate-50); border: 1px solid var(--color-line); display: grid; place-items: end center; overflow: hidden; }
  .phone { width: 180px; height: 120px; background: var(--white); border: 1.5px solid var(--slate-200); border-bottom: 0; border-radius: 22px 22px 0 0; padding: 10px 14px 0; display: grid; gap: 8px; align-content: start; }
  .phone-top { width: 52px; height: 6px; border-radius: 6px; background: var(--slate-150); justify-self: center; }
  .phone-h { font-weight: 700; font-size: 0.9375rem; }
  .phone-btn { background: var(--slate); color: var(--white); border-radius: 8px; padding: 6px 10px; font-size: 0.8125rem; font-weight: 650; text-align: center; }
  .phone-row { display: flex; align-items: center; gap: 8px; font-size: 0.8125rem; color: var(--slate-600); }
  .phone-row i { width: 16px; height: 16px; border-radius: 4px; background: var(--sun); }
  .how-foot { margin-top: 28px; display: grid; gap: 16px; align-items: center; }
  @media (min-width: 960px) { .how-foot { grid-template-columns: 1fr auto; } }

  .paths { display: grid; gap: 20px; }
  @media (min-width: 960px) { .paths { grid-template-columns: 320px minmax(0, 1fr); align-items: start; } }
  .paths-tabs { display: grid; gap: 8px; }
  @media (max-width: 959px) { .paths-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .paths-tabs button {
    display: grid; gap: 4px; text-align: left; padding: 14px 16px; min-height: 44px; border-radius: var(--radius);
    border: 1px solid var(--color-line); background: var(--white); color: var(--slate); cursor: pointer; font: inherit;
    transition: border-color var(--speed) var(--ease), box-shadow var(--speed) var(--ease);
  }
  .paths-tabs strong { font-weight: 700; font-size: 1.0625rem; }
  .paths-tabs span { font-size: var(--text-sm); color: var(--color-muted); line-height: 1.4; }
  .paths-tabs button:hover { border-color: var(--slate-300); }
  .paths-tabs button[aria-selected="true"] { border-color: var(--slate); box-shadow: inset 4px 0 0 var(--sun); }
  .paths-panel { display: grid; gap: 16px; min-width: 0; }
  .paths-panel > p { font-size: 1.125rem; color: var(--slate-700); }

  .closing { text-align: center; }
  .closing-inner { display: grid; justify-items: center; gap: 18px; }
  .closing p { color: var(--slate-300); font-size: 1.125rem; }
  .closing-cmd { display: flex; align-items: center; gap: 12px; max-width: 100%; padding: 10px 10px 10px 18px; background: var(--slate-950); border: 1px solid var(--slate-700); border-radius: 14px; }
  .closing-cmd code { font: 500 1rem/1.5 var(--font-mono); color: var(--white); background: none; border: 0; padding: 0; text-align: left; overflow-wrap: anywhere; }
  .closing .btn-row { justify-content: center; }
  .caps { display: grid; }
  .more { margin-top: 28px; }
  .integ { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .integ-card { display: grid; gap: 8px; align-content: start; padding: 22px; background: var(--white); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .integ-card p { color: var(--slate-700); font-size: var(--text-sm); }
  .integ-card { padding-top: 0; overflow: hidden; }
  .integ-pkg { margin: 0 -22px 8px; padding: 12px 22px; background: var(--slate); color: var(--sun); font: 500 0.8125rem/1.4 var(--font-mono); overflow-wrap: anywhere; border-bottom: 3px solid var(--sun); }
  .mcp { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 960px) { .mcp { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }
  .mcp-copy { display: grid; gap: 18px; justify-items: start; }
  .mcp-copy p { color: var(--slate-200); font-size: 1.125rem; }
  .mcp-code { display: grid; gap: 16px; min-width: 0; }
  .mcp-code :global(.code) { border-color: var(--slate-700); }
  .uses { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 40px; }
  @media (min-width: 800px) { .uses { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .uses li { display: flex; gap: 16px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--color-line); font-size: 1.125rem; font-weight: 560; }
  .uses span { font: 600 0.875rem/1 var(--font-mono); color: var(--sun-ink); }
  .status { display: grid; gap: 32px; }
  .status-grid { display: grid; gap: 16px; }
  @media (min-width: 720px) { .status-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .status-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .status-grid .card { display: grid; gap: 10px; align-content: start; }
  .status-grid .card p { color: var(--slate-700); font-size: var(--text-sm); }
  .status-grid .card:nth-child(2) { background: var(--sun-soft); border-color: #f3dc8a; }
  .faq-wrap { max-width: 880px; }
  .routes { display: grid; gap: 20px; }
  @media (min-width: 860px) { .routes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .route { display: grid; gap: 14px; align-content: start; padding: 32px; border-radius: var(--radius-lg); border: 1px solid var(--color-line); background: var(--slate-50); }
  .route p { color: var(--slate-700); }
  .route--biz { background: var(--white); border-color: var(--slate); }
</style>
