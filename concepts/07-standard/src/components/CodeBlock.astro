---
/**
 * A code panel: title bar, syntax colour (Shiki at build time, 07's own theme)
 * and a Copy button. `example` labels illustrative output as "Example output".
 */
import { Code } from "astro:components";
import { slateSun } from "../lib/shiki-theme";

interface Props {
  code: string;
  lang?: string;
  title?: string;
  example?: boolean;
  copy?: boolean;
  class?: string;
}
const { code, lang = "bash", title, example = false, copy = true, class: cls } = Astro.props;
const label = title ?? ({ bash: "Terminal", sh: "Terminal", js: "JavaScript", ts: "TypeScript", json: "JSON", powershell: "PowerShell" } as Record<string, string>)[lang] ?? lang;
---

<figure class:list={["code", cls]}>
  <figcaption class="code-bar">
    <span class="code-title">{label}</span>
    {example && <span class="code-example">Example output</span>}
    {copy && (
      <button class="copy" type="button" data-copy={code} aria-label={`Copy ${label.toLowerCase()} code`}>
        <span class="copy-label">Copy</span>
      </button>
    )}
  </figcaption>
  <div class="code-body">
    <Code code={code} lang={lang as any} theme={slateSun as any} />
  </div>
</figure>

<style>
  .code {
    margin: 0; min-width: 0; background: var(--code-bg); color: var(--code-ink);
    border-radius: var(--radius); overflow: hidden; border: 1px solid var(--slate-800);
  }
  .code-bar {
    display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 6px 0 16px;
    background: var(--code-bar); border-bottom: 1px solid var(--slate-800);
  }
  .code-title { font: 600 0.875rem/1 var(--font-mono); color: var(--code-dim); }
  .code-example {
    font: 600 0.8125rem/1 var(--font-text); color: var(--slate); background: var(--sun); padding: 4px 8px; border-radius: 999px;
  }
  .code-body { overflow-x: auto; }
  .code-body :global(pre) {
    margin: 0; padding: 18px 20px 20px; background: transparent !important;
    font: 450 var(--text-mono)/1.65 var(--font-mono); tab-size: 2;
  }
  .code-body :global(code) { font: inherit; background: none; border: 0; padding: 0; }
</style>
