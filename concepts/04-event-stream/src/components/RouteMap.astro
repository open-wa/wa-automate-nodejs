---
/** Events stream into one session and fan out to plugins: inngest-style routing. */
import { types } from "../data/events";
import { integrations } from "../data/site";
const L = types.map((t, i) => ({ ...t, y: 40 + i * 64 }));
const R = integrations.map((g, i) => ({ ...g, y: 20 + i * 62 }));
const cy = 230;
const lp = (y: number) => `M210 ${y + 18} C330 ${y + 18} 330 ${cy} 450 ${cy}`;
const rp = (y: number) => `M650 ${cy} C760 ${cy} 760 ${y + 18} 860 ${y + 18}`;
---

<figure class="rm" data-rm>
  <svg viewBox="0 0 1100 460" role="img" aria-labelledby="rm-t">
    <title id="rm-t">Six event types flow into an Easy API session, which forwards them to webhooks, Chatwoot, Node-RED, S3, the Cloudflare Session Proxy, MCP and your own plugins.</title>
    <g class="rm-wires">
      {L.map((n, i) => <path id={`rml${i}`} d={lp(n.y)} />)}
      {R.map((n, i) => <path id={`rmr${i}`} d={rp(n.y)} />)}
    </g>
    <g class="rm-pk">
      {L.map((_, i) => (
        <circle r="4"><animateMotion dur="2.6s" begin={`${-i * 0.43}s`} repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href={`#rml${i}`} /></animateMotion></circle>
      ))}
      {R.map((_, i) => (
        <circle r="4" class="out"><animateMotion dur="2.6s" begin={`${-i * 0.37 - 1.3}s`} repeatCount="indefinite"><mpath href={`#rmr${i}`} /></animateMotion></circle>
      ))}
    </g>
    {L.map((n) => (
      <g class="rm-node" transform={`translate(20 ${n.y})`}>
        <rect width="190" height="36" rx="5" />
        <text x="14" y="23" class="rm-glyph">{n.glyph}</text>
        <text x="34" y="23">{n.handler.length > 18 ? n.handler.replace("onGlobalParticipantsChanged", "onParticipants…") : n.handler}</text>
      </g>
    ))}
    <g class="rm-core" transform="translate(450 170)">
      <rect width="200" height="120" rx="8" />
      <text x="100" y="50" text-anchor="middle" class="rm-core-t">Easy API</text>
      <text x="100" y="76" text-anchor="middle" class="rm-core-s">session sales</text>
      <text x="100" y="98" text-anchor="middle" class="rm-core-s">localhost:8080</text>
    </g>
    {R.map((n) => (
      <g class="rm-node rm-dst" transform={`translate(860 ${n.y})`}>
        <rect width="230" height="36" rx="5" />
        <text x="14" y="23">{n.name}</text>
      </g>
    ))}
  </svg>
  <figcaption class="mono"><span class="example">Example output</span> Events in, plugins out. Most are a package you list in <code>plugins</code>; MCP is built in.</figcaption>
</figure>

<script>
  import { shouldAnimate } from "../lib/runtime";
  const svg = document.querySelector<SVGSVGElement>("[data-rm] svg");
  if (svg && !shouldAnimate()) { svg.pauseAnimations(); svg.setCurrentTime(1.1); }
</script>

<style>
  .rm { margin: 0; background: var(--graphite-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px; }
  .rm svg { display: block; width: 100%; height: auto; }
  .rm-wires path { fill: none; stroke: var(--graphite-4); stroke-width: 1.5; }
  .rm-pk circle { fill: var(--cyan); filter: drop-shadow(0 0 4px rgba(63,224,240,.8)); }
  .rm-pk circle.out { fill: var(--warm); filter: none; }
  .rm-node rect { fill: var(--graphite); stroke: var(--line); }
  .rm-node text { fill: var(--cyan); font: 500 15px var(--font-mono); }
  .rm-node .rm-glyph { fill: var(--warm); }
  .rm-dst text { fill: var(--warm); font: 500 16px var(--font-text); }
  .rm-dst rect { stroke: var(--cyan-dim); }
  .rm-core rect { fill: #0d0f12; stroke: var(--cyan); stroke-width: 1.5; }
  .rm-core-t { fill: var(--warm); font: 600 24px var(--font-display); }
  .rm-core-s { fill: var(--muted); font: 400 14px var(--font-mono); }
  .rm figcaption { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; font-size: 13px; color: var(--muted); margin-top: 14px; }
  .rm figcaption code { color: var(--cyan); }
  @media (max-width: 700px) { .rm { display: none; } }
</style>
