---
/**
 * The lead seam: tier, GitHub username, WhatsApp number, use case, then a
 * confirmation naming the tier and the next step (prefilled Gumroad checkout).
 * Validates as people type and on submit, never on blur.
 */
import { licences } from "../data/site";
const f = Object.fromEntries(licences.checkoutFields.map((x) => [x.name, x]));
const tiers = licences.tiers.map((t) => ({ id: t.id, name: t.name, month: t.prices.month, year: t.prices.year }));
---

<div class="lf" data-lf>
  <form class="lf-form" novalidate data-lf-form>
    <fieldset class="lf-tiers">
      <legend class="lf-label">{f.tier.label}</legend>
      <div class="lf-tier-row">
        {tiers.map((t, i) => (
          <label class="lf-tier">
            <input type="radio" name="tier" value={t.id} checked={i === 0} />
            <span class="lf-tier-box">
              <span class="lf-tier-name">{t.name}</span>
              <span class="mono muted">from {t.month}/month &middot; {t.year}/year</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="lf-field">
      <label class="lf-label" for="lf-github">{f.github.label}</label>
      <input id="lf-github" name="github" type="text" autocomplete="username" autocapitalize="off" spellcheck="false" aria-describedby="lf-github-help lf-github-err" />
      <p class="lf-help" id="lf-github-help">Without the @, for example smashah.</p>
      <p class="lf-err" id="lf-github-err" aria-live="polite"></p>
    </div>

    <div class="lf-field">
      <label class="lf-label" for="lf-phone">{f.phone.label}</label>
      <input id="lf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+44 7700 900123" aria-describedby="lf-phone-help lf-phone-err" />
      <p class="lf-help" id="lf-phone-help">{f.phone.help} The key works for that one number.</p>
      <p class="lf-err" id="lf-phone-err" aria-live="polite"></p>
    </div>

    <div class="lf-field">
      <label class="lf-label" for="lf-use">{f.useCase.label}</label>
      <textarea id="lf-use" name="useCase" rows="3" placeholder={f.useCase.placeholder} aria-describedby="lf-use-err"></textarea>
      <p class="lf-err" id="lf-use-err" aria-live="polite"></p>
    </div>

    <button class="btn btn-cyan lf-submit" type="submit">Continue to checkout</button>
    <p class="lf-help">No account needed. Next you review the price on Gumroad and pay there.</p>
  </form>

  <div class="lf-done" data-lf-done hidden tabindex="-1">
    <p class="label">Details saved</p>
    <h3 data-lf-title>Your Insiders key is one step away</h3>
    <p data-lf-body></p>
    <ol class="lf-steps">
      <li>Review the price and terms on the prefilled Gumroad checkout, then pay there.</li>
      <li>Your key arrives from Gumroad. Start with <code class="mono">--license-key "YOUR-LICENSE-KEY"</code>, or apply it from the dashboard with no restart.</li>
      <li>Test the method you need in that session.</li>
    </ol>
    <div class="lf-done-actions">
      <a class="btn btn-cyan" data-lf-checkout href="https://openwa.dev/checkout?tier=insiders">Open Gumroad checkout</a>
      <button class="btn" type="button" data-lf-edit>Change details</button>
    </div>
    <p class="lf-help">Demo: this concept stores your details in this tab only. Checkout shows the current price.</p>
  </div>
</div>

<script>
  import { submitLead } from "../lib/leads";

  const root = document.querySelector<HTMLElement>("[data-lf]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-lf-form]")!;
    const done = root.querySelector<HTMLElement>("[data-lf-done]")!;
    const touched = new Set<string>();
    const names: Record<string, string> = { insiders: "Insiders", restricted: "Restricted" };

    // Arabic-Indic (U+0660..0669) and Persian (U+06F0..06F9) digits become 0-9.
    const latinDigits = (s: string) =>
      s.replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660))
       .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06f0));
    const normPhone = (s: string) => {
      let v = latinDigits(s).trim().replace(/[\s().\-]/g, "");
      if (v.startsWith("00")) v = `+${v.slice(2)}`;
      return v;
    };

    const rules: Record<string, (v: string) => string> = {
      github: (v) => !v.trim() ? "Add your GitHub username."
        : !/^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}$/.test(v.trim().replace(/^@/, "")) ? "Use letters, numbers and single hyphens, as on GitHub." : "",
      phone: (v) => {
        const n = normPhone(v);
        if (!n) return "Add the WhatsApp number this key is for.";
        if (!n.startsWith("+")) return "Start with + and the country code, for example +44.";
        if (!/^\+\d{7,15}$/.test(n)) return "That doesn't look like a full number. Use 7 to 15 digits after the +.";
        return "";
      },
      useCase: (v) => v.trim().length < 4 ? "Tell us in a few words what you'll use it for." : "",
    };

    const check = (name: string, show: boolean) => {
      const el = form.elements.namedItem(name) as HTMLInputElement;
      const msg = rules[name](el.value);
      const err = root.querySelector<HTMLElement>(`#${el.id}-err`)!;
      if (show) {
        err.textContent = msg;
        el.setAttribute("aria-invalid", String(!!msg));
      }
      return !msg;
    };

    form.addEventListener("input", (e) => {
      const el = e.target as HTMLInputElement;
      if (!rules[el.name]) return;
      // Show errors as people type once they've typed something, and clear them as soon as it's valid.
      if (el.value.trim()) touched.add(el.name);
      check(el.name, touched.has(el.name));
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fields = Object.keys(rules);
      fields.forEach((n) => touched.add(n));
      const ok = fields.map((n) => check(n, true)).every(Boolean);
      if (!ok) {
        const first = fields.find((n) => !check(n, false));
        (form.elements.namedItem(first!) as HTMLElement)?.focus();
        return;
      }
      const data = new FormData(form);
      const tier = String(data.get("tier"));
      const submit = form.querySelector<HTMLButtonElement>(".lf-submit")!;
      submit.disabled = true; submit.textContent = "Saving";
      await submitLead("licence", {
        tier,
        github: String(data.get("github")).trim().replace(/^@/, ""),
        phone: normPhone(String(data.get("phone"))),
        useCase: String(data.get("useCase")).trim(),
      });
      submit.disabled = false; submit.textContent = "Continue to checkout";
      root.querySelector("[data-lf-title]")!.textContent = `Your ${names[tier]} key is one step away`;
      root.querySelector("[data-lf-body]")!.textContent =
        `${names[tier]} licence for ${normPhone(String(data.get("phone")))}, linked to GitHub user ${String(data.get("github")).trim().replace(/^@/, "")}. Next is a prefilled Gumroad checkout where you review the price and pay.`;
      root.querySelector<HTMLAnchorElement>("[data-lf-checkout]")!.href = `https://openwa.dev/checkout?tier=${tier}`;
      form.hidden = true; done.hidden = false; done.focus({ preventScroll: false });
    });

    root.querySelector("[data-lf-edit]")!.addEventListener("click", () => {
      done.hidden = true; form.hidden = false;
      form.querySelector<HTMLInputElement>("input[name=tier]:checked")?.focus();
    });

    // Preselect a tier from ?tier= or a link.
    const want = new URLSearchParams(location.search).get("tier");
    if (want) form.querySelector<HTMLInputElement>(`input[name=tier][value="${CSS.escape(want)}"]`)?.click();
    document.querySelectorAll<HTMLAnchorElement>("[data-pick-tier]").forEach((a) =>
      a.addEventListener("click", () => form.querySelector<HTMLInputElement>(`input[name=tier][value="${a.dataset.pickTier}"]`)?.click()));
  }
</script>

<style>
  .lf { background: var(--graphite-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(18px, 3vw, 32px); }
  .lf-form { display: grid; gap: 20px; }
  .lf-tiers { border: 0; padding: 0; margin: 0; }
  .lf-label { display: block; font: 600 16px/1.3 var(--font-text); color: var(--warm); margin-bottom: 8px; padding: 0; }
  .lf-tier-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .lf-tier { position: relative; }
  .lf-tier input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .lf-tier-box { display: grid; gap: 4px; padding: 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--graphite); min-height: 64px; font-size: 14px; }
  .lf-tier-name { font: 600 18px/1.2 var(--font-display); color: var(--warm); }
  .lf-tier input:checked + .lf-tier-box { border-color: var(--cyan); box-shadow: inset 0 0 0 1px var(--cyan); }
  .lf-tier input:focus-visible + .lf-tier-box { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .lf-field input, .lf-field textarea {
    width: 100%; min-height: 48px; padding: 12px 14px; font: 400 17px/1.4 var(--font-text); color: var(--warm);
    background: var(--graphite); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .lf-field input:focus, .lf-field textarea:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(63,224,240,.18); }
  .lf-field [aria-invalid="true"] { border-color: var(--alert); }
  .lf-help { color: var(--muted); font-size: 15px; margin: 6px 0 0; }
  .lf-err { color: #ff8da1; font-size: 15px; margin: 6px 0 0; min-height: 0; }
  .lf-err:empty { display: none; }
  .lf-submit { width: 100%; min-height: 52px; font-size: 17px; }
  .lf-done { display: grid; gap: 12px; outline: none; }
  .lf-done h3 { font-size: 26px; }
  .lf-done p { margin: 0; color: #d6d8da; }
  .lf-steps { margin: 4px 0; padding-left: 20px; color: #d6d8da; display: grid; gap: 6px; }
  .lf-steps code { font-size: 14px; background: var(--graphite-3); padding: 1px 5px; border-radius: 4px; word-break: break-all; }
  .lf-done-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 480px) { .lf-tier-row { grid-template-columns: 1fr; } }
</style>
