---
import Page from "../layouts/Page.astro";
import PageHead from "../components/PageHead.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { support, stats, snippets, releases, kfloor, href } from "../data/site";
---
<Page title="Community: Discord, GitHub and plugins | open-wa" description="Join open-wa on Discord and GitHub, contribute, build a plugin with the Plugin SDK and follow releases.">
  <div class="wrap">
    <PageHead kicker="community" title="Built in the open since 2019" lede={`By ${support.maintainer} and contributors. Numbers checked ${stats.checkedOn}.`} />
    <dl class="cm-stats">
      <div><dt>GitHub stars</dt><dd>{kfloor(stats.githubStars)}</dd></div>
      <div><dt>Forks</dt><dd>{stats.githubForks}</dd></div>
      <div><dt>Discord members</dt><dd>{stats.discordMembers.toLocaleString("en-GB")}</dd></div>
      <div><dt>npm downloads, 30 days</dt><dd>{kfloor(stats.npmDownloadsLast30Days)}</dd></div>
    </dl>
    <div class="grid-2 cm-cards">
      <article class="card"><h2>Discord</h2><p>Ask questions, share what you've built and hear about releases first.</p><a class="btn btn-amber" href={support.discord}>Join Discord</a></article>
      <article class="card"><h2>GitHub</h2><p>Star the repo, report bugs, and read the contributing guide before a pull request.</p><a class="btn" href={support.github}>open-wa on GitHub</a></article>
      <article class="card"><h2>Releases</h2><p>Latest: {releases[0].version} on {releases[0].date}, "{releases[0].headline}".</p><a class="btn" href={href("changelog/")}>Changelog</a></article>
      <article class="card"><h2>Sponsor</h2><p>Keep the maintainer in coffee while the project stays free for most methods.</p><a class="btn" href={support.buyMeACoffee}>Buy me a coffee</a></article>
    </div>
    <section class="sec" id="plugins" aria-labelledby="pl-h">
      <div class="sec-head"><h2 id="pl-h">Write a plugin</h2><p>Package your integration with <code>@open-wa/plugin-sdk</code> and load it by name or path.</p></div>
      <CodeBlock code={snippets.plugins} lang="js" title="wa.config.mjs" />
    </section>
  </div>
</Page>
<style>
  .cm-stats { margin: 0 0 32px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .cm-stats > div { background: var(--ink); padding: 16px; }
  .cm-stats dt { color: var(--grey); font-size: 16px; }
  .cm-stats dd { margin: 0; font-family: var(--font-display); font-size: 33px; color: var(--amber); }
  .cm-cards .btn { justify-self: start; }
  @media (max-width: 760px) { .cm-stats { grid-template-columns: 1fr 1fr; } }
</style>
