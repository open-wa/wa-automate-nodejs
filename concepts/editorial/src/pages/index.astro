---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/fragment-mono/400.css';
import '../styles/feature.css';

const base = import.meta.env.BASE_URL;

const links = {
  quickstart: 'https://openwa.dev/docs/getting-started/quickstart',
  docs: 'https://openwa.dev/docs',
  reference: 'https://openwa.dev/docs/reference/client/client',
  github: 'https://github.com/open-wa/wa-automate-nodejs',
  discord: 'https://discord.gg/dpan7EYE3t',
  licensing: 'https://openwa.dev/docs/licensing/licensed-features',
};

const chapters = [
  { id: 'why', n: 'I', word: 'one', title: 'Your number, your server' },
  { id: 'command', n: 'II', word: 'two', title: 'One command' },
  { id: 'ways-in', n: 'III', word: 'three', title: 'Four ways in' },
  { id: 'plugged-in', n: 'IV', word: 'four', title: 'Plugged in' },
  { id: 'running', n: 'V', word: 'five', title: 'Running it well' },
  { id: 'licensing', n: 'VI', word: 'six', title: 'A note on licensing' },
  { id: 'start', n: 'VII', word: 'seven', title: 'How to start' },
];

// Tiny build-time highlighter: no runtime cost, no library.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
function hl(code: string, lang: 'sh' | 'ts') {
  const re =
    lang === 'sh'
      ? /('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|(\s--?[a-zA-Z][\w-]*)|(\\$)|(^(?:npx|curl|docker)\b)/gm
      : /(\/\/[^\n]*)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|\b(import|from|const|await|async|if|export|default|new|true)\b/g;
  let out = '';
  let last = 0;
  for (const m of code.matchAll(re)) {
    out += esc(code.slice(last, m.index));
    const [t] = m;
    let cls = '';
    if (lang === 'sh') cls = m[1] ? 's' : m[2] ? 'f' : m[3] ? 'c' : 'k';
    else cls = m[1] ? 'c' : m[2] ? 's' : 'k';
    out += `<span class="t-${cls}">${esc(t)}</span>`;
    last = (m.index ?? 0) + t.length;
  }
  return out + esc(code.slice(last));
}

const snippets = {
  npx: 'npx @open-wa/wa-automate@latest --port 8080',
  docker: 'docker run -p 8080:8080 --init openwa/wa-automate',
  curl: `curl -X POST http://localhost:8080/api/messages/sendText \\
  -H "Content-Type: application/json" \\
  -d '{"to": "447123456789@c.us", "content": "Your order is ready to collect!"}'`,
  socket: `import { SocketClient } from '@open-wa/socket-client';

const client = await SocketClient.connect('http://localhost:8080', 'your-secure-key');
client.onMessage(async (message) => {
  if (message.body === 'Hi') await client.sendText(message.from, 'Hello!');
});`,
  embedded: `import { createClient } from '@open-wa/wa-automate';
import { PuppeteerDriver } from '@open-wa/driver-puppeteer';

const client = await createClient({ sessionId: 'sales', driver: new PuppeteerDriver(), headless: true });`,
  mcp: `// wa.config.mjs: MCP
export default { apiKey: process.env.WA_API_KEY, port: 8080, mcp: { enabled: true, path: '/mcp' } };`,
  session: 'npx @open-wa/wa-automate@latest --session-id sales --port 8081',
  apikey: 'npx @open-wa/wa-automate@latest --port 8080 --api-key "your-secure-key"',
};
const word = 'open-wa'.split('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>open-wa · The Feature</title>
    <meta name="description" content="A feature in seven chapters on open-wa: WhatsApp automation on your own infrastructure. Open source since August 2019, now v5." />
    <meta name="theme-color" content="#ECEBF3" />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        // Failsafe: if the script never runs, show the cover at rest.
        setTimeout(function () { if (!window.__feature) document.documentElement.classList.remove('motion'); }, 3000);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#why">Skip to the first chapter</a>

    <!-- Phone and tablet: running head with the chapter menu -->
    <header class="runhead">
      <a class="logo logo--small" href="#top" aria-label="open-wa, back to the cover">
        <svg class="mono" viewBox="0 0 64 64" aria-hidden="true">
          <rect class="mono-bg" width="64" height="64" />
          <g class="mono-o"><path fill-rule="evenodd" d="M15 21a11 15 0 1 0 0.001 0zM15 22.4a5.2 13.6 0 1 1 -0.001 0z" /></g>
          <g class="mono-w">
            <path d="M27 21h6.4l7.6 30h-2.6z" /><path d="M38.6 51h1.5l6.2-30h-1.4z" />
            <path d="M42.6 21h6.4l7.6 30h-2.6z" /><path d="M54.2 51h1.5l6.2-30h-1.4z" />
            <path d="M24.5 20.2h10.8v1.2h-10.8zM40.3 20.2h10.8v1.2h-10.8zM56.6 20.2h6v1.2h-6z" />
          </g>
        </svg>
        <span class="word" aria-hidden="true">
          {word.map((ch, i) => (
            <span class="l" style={`--i:${i}`}><span class="r">{ch}</span><span class="it">{ch}</span></span>
          ))}
        </span>
      </a>
      <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="spine">
        <span class="menu-btn__label">Contents</span>
        <span class="menu-btn__now" id="menu-now" aria-hidden="true">Cover</span>
      </button>
      <span class="rule rule--h" aria-hidden="true"><span></span></span>
    </header>

    <!-- Desktop: the spine. Phone: the same element becomes the chapter menu -->
    <aside class="spine" id="spine" aria-label="Contents">
      <a class="logo" href="#top" aria-label="open-wa, back to the cover">
        <svg class="mono" viewBox="0 0 64 64" aria-hidden="true">
          <rect class="mono-bg" width="64" height="64" />
          <g class="mono-o"><path fill-rule="evenodd" d="M15 21a11 15 0 1 0 0.001 0zM15 22.4a5.2 13.6 0 1 1 -0.001 0z" /></g>
          <g class="mono-w">
            <path d="M27 21h6.4l7.6 30h-2.6z" /><path d="M38.6 51h1.5l6.2-30h-1.4z" />
            <path d="M42.6 21h6.4l7.6 30h-2.6z" /><path d="M54.2 51h1.5l6.2-30h-1.4z" />
            <path d="M24.5 20.2h10.8v1.2h-10.8zM40.3 20.2h10.8v1.2h-10.8zM56.6 20.2h6v1.2h-6z" />
          </g>
        </svg>
        <span class="word" aria-hidden="true">
          {word.map((ch, i) => (
            <span class="l" style={`--i:${i}`}><span class="r">{ch}</span><span class="it">{ch}</span></span>
          ))}
        </span>
      </a>
      <p class="spine__issue label">The Feature<br />v5.0.0 · since Aug 2019</p>

      <nav class="index" aria-label="Chapters">
        <p class="label index__head">Contents</p>
        <ol>
          {chapters.map((c) => (
            <li>
              <a href={`#${c.id}`} data-for={c.id}>
                <span class="index__n">{c.n}</span>
                <span class="index__t">{c.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="spine__foot">
        <a class="btn btn--primary" href={links.quickstart}>Send your first message <span aria-hidden="true">→</span></a>
        <p class="spine__links">
          <a href={links.docs}>Docs</a>
          <a href={links.github}>GitHub</a>
          <a href={links.discord}>Discord</a>
        </p>
      </div>
      <span class="rule rule--v" aria-hidden="true"><span></span></span>
      <button class="menu-close" id="menu-close" type="button">Close contents</button>
    </aside>

    <main id="main">
      <!-- ============ COVER ============ -->
      <section class="hero" id="top" aria-labelledby="hero-title">
        <p class="hero__kicker label">
          <span>The Feature</span>
          <span>Seven chapters</span>
          <span>Open source since August 2019</span>
        </p>
        <h1 id="hero-title" class="hero__title">WhatsApp automation, on <em>your own</em> infrastructure.</h1>

        <div class="hero__below">
          <div class="hero__copy">
            <p class="standfirst">
              For seven years, open-wa has been the quiet infrastructure behind WhatsApp bots: a Node.js
              toolkit that turns a WhatsApp account into an API you run on your own machine or server.
              Version&nbsp;5 is the current stable line. This is how it works, and how to start.
            </p>
            <div class="cta-row">
              <a class="btn btn--primary btn--lg" href={links.quickstart}>Send your first message <span aria-hidden="true">→</span></a>
              <a class="btn btn--quiet" href={links.docs}>Read the docs</a>
            </div>
          </div>

          <dl class="numbers" aria-label="By the numbers">
            <div><dt class="label">Stars on GitHub</dt><dd>3,666</dd></div>
            <div><dt class="label">Forks</dt><dd>723</dd></div>
            <div><dt class="label">Open source since</dt><dd>2019</dd></div>
            <div><dt class="label">Stable release line</dt><dd><i>v</i>5</dd></div>
          </dl>
        </div>
        <p class="hero__fine">open-wa is unofficial and not affiliated with WhatsApp or Meta.</p>
      </section>

      <!-- ============ I ============ -->
      <section class="chapter" id="why" data-chapter="why" aria-labelledby="why-t">
        <header class="opener">
          <span class="opener__n" aria-hidden="true">I</span>
          <div>
            <p class="label">Chapter one</p>
            <h2 id="why-t">Your number, your server</h2>
            <p class="dek">Why put WhatsApp behind an API you run yourself.</p>
          </div>
        </header>

        <div class="body">
          <p class="drop">
            Most WhatsApp automation is unglamorous, and that is the point. An order is ready to collect.
            A booking has moved. A delivery is on its way. A support inbox needs more than one pair of
            hands, a community needs a bot, a CRM or helpdesk needs to hear about the conversation, and,
            lately, an AI agent needs a number of its own.
          </p>
          <p>
            open-wa is built for the developers and small teams who do that work. Published as
            <code>@open-wa/wa-automate</code>, it is a Node.js toolkit that turns a WhatsApp account into an
            API on your own machine or server. You decide where it runs, which number it speaks for and
            who holds the key.<sup class="ref"><a href="#n1" id="r1" aria-label="Note 1">1</a></sup>
          </p>
          <aside class="note" id="n1" aria-label="Note 1">
            <span class="note__n">1</span>
            open-wa is unofficial and not affiliated with WhatsApp or Meta. Automating an account carries
            risk, and nothing here makes an account safe from bans.
          </aside>

          <blockquote class="pull">
            <p class="pull__q">Turn a WhatsApp account into an API, bot runtime, webhook bridge, and AI tool surface.</p>
            <footer class="label">The project, in its own words</footer>
          </blockquote>

          <p>
            That sentence is the whole shape of it. Each of those nouns is a way in, and the rest of this
            feature takes them one at a time, starting with the shortest: a single command.
          </p>
        </div>
      </section>

      <!-- ============ II ============ -->
      <section class="chapter" id="command" data-chapter="command" aria-labelledby="command-t">
        <header class="opener">
          <span class="opener__n" aria-hidden="true">II</span>
          <div>
            <p class="label">Chapter two</p>
            <h2 id="command-t">One command</h2>
            <p class="dek">From an empty terminal to a working API.</p>
          </div>
        </header>

        <div class="body">
          <p class="drop">
            Everything starts in a terminal. One <code>npx</code> command fetches the current release and starts
            the Easy API, a local HTTP server that speaks for your WhatsApp account.
          </p>

          <figure class="fig fig--narrow">
            <div class="fig__plate">
              <pre><code set:html={hl(snippets.npx, 'sh')} /></pre>
              <button class="copy" type="button" data-copy={snippets.npx}>Copy</button>
            </div>
            <figcaption><span class="label">Fig. 1</span> Starts the Easy API on port 8080. Requires Node.js 22.21.1 or newer.</figcaption>
          </figure>
          <aside class="note" aria-label="Note 2">
            <span class="note__n">2</span>
            Prefer containers? The same API runs from the image:
            <code class="note__code">docker run -p 8080:8080 --init openwa/wa-automate</code>
          </aside>

          <p>
            The first time, it asks you to log in, by QR code or by link code. You do this once per named
            session; after that, the session is yours to address.
          </p>
          <p>
            Then you send something. Anything that can make an HTTP request can do this, which is to say
            almost everything you already run.
          </p>

          <figure class="fig">
            <div class="fig__plate">
              <pre><code set:html={hl(snippets.curl, 'sh')} /></pre>
              <button class="copy" type="button" data-copy={snippets.curl}>Copy</button>
            </div>
            <figcaption><span class="label">Fig. 2</span> The first message. Every endpoint is documented live at <code>/api-docs/</code>.</figcaption>
          </figure>

          <p class="inline-cta">
            <a class="btn btn--primary" href={links.quickstart}>Send your first message <span aria-hidden="true">→</span></a>
            <span class="inline-cta__aside">The quickstart walks through it, step by step.</span>
          </p>
        </div>
      </section>

      <!-- ============ III ============ -->
      <section class="chapter chapter--night" id="ways-in" data-chapter="ways-in" aria-labelledby="ways-t">
        <header class="opener">
          <span class="opener__n" aria-hidden="true">III</span>
          <div>
            <p class="label">Chapter three</p>
            <h2 id="ways-t">Four ways in</h2>
            <p class="dek">The Easy API is the front door. It is not the only one.</p>
          </div>
        </header>

        <div class="body">
          <p class="drop">
            open-wa meets your code where it already lives. Some teams want an HTTP API and nothing else.
            Some have a Node.js service that should listen for messages. Some want the runtime inside their
            own process, and some want to hand the whole thing to an AI agent. There is a door for each.
          </p>

          <ol class="ways">
            <li class="way">
              <p class="way__n label">a.</p>
              <h3>Easy API <span>the CLI</span></h3>
              <p>
                A local HTTP API with live docs at <code>/api-docs/</code>, an OpenAPI document at
                <code>/meta/swagger.json</code> and a Postman collection at <code>/meta/postman.json</code>.
                Import it into the tools you already use.
              </p>
            </li>
            <li class="way">
              <p class="way__n label">b.</p>
              <h3>SocketClient <span>another Node.js app</span></h3>
              <p>
                Connect a separate Node.js app to a running Easy API. Commands travel over HTTP RPC; events
                arrive as Server-Sent Events.
              </p>
              <figure class="fig">
                <div class="fig__plate">
                  <pre><code set:html={hl(snippets.socket, 'ts')} /></pre>
                  <button class="copy" type="button" data-copy={snippets.socket}>Copy</button>
                </div>
                <figcaption><span class="label">Fig. 3</span> A bot that answers “Hi”, running beside the Easy API.</figcaption>
              </figure>
            </li>
            <li class="way">
              <p class="way__n label">c.</p>
              <h3>Embedded runtime <span>inside your process</span></h3>
              <p>
                <code>createClient</code> inside your own Node.js app, with a pluggable browser driver.
              </p>
              <figure class="fig">
                <div class="fig__plate">
                  <pre><code set:html={hl(snippets.embedded, 'ts')} /></pre>
                  <button class="copy" type="button" data-copy={snippets.embedded}>Copy</button>
                </div>
                <figcaption><span class="label">Fig. 4</span> A named session, a driver, no window.</figcaption>
              </figure>
            </li>
            <li class="way">
              <p class="way__n label">d.</p>
              <h3>MCP <span>for AI agents</span></h3>
              <p>
                A built-in Model Context Protocol server at <code>/mcp</code>. Every Easy API method becomes a
                tool for Claude, Cursor or Windsurf.
              </p>
              <figure class="fig">
                <div class="fig__plate">
                  <pre><code set:html={hl(snippets.mcp, 'ts')} /></pre>
                  <button class="copy" type="button" data-copy={snippets.mcp}>Copy</button>
                </div>
                <figcaption><span class="label">Fig. 5</span> Turning on the MCP server in <code>wa.config.mjs</code>.</figcaption>
              </figure>
            </li>
          </ol>

          <blockquote class="pull">
            <p class="pull__q">Connect WhatsApp to your application.</p>
            <footer class="label">The project, in its own words</footer>
          </blockquote>

          <p class="inline-cta">
            <a class="btn btn--primary" href={links.reference}>Browse the client API reference <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </section>

      <!-- ============ IV ============ -->
      <section class="chapter" id="plugged-in" data-chapter="plugged-in" aria-labelledby="plugged-t">
        <header class="opener">
          <span class="opener__n" aria-hidden="true">IV</span>
          <div>
            <p class="label">Chapter four</p>
            <h2 id="plugged-t">Plugged in</h2>
            <p class="dek">A message rarely ends at the API.</p>
          </div>
        </header>

        <div class="body">
          <p class="drop">
            A message needs to land somewhere: a helpdesk, a storage bucket, a flow, someone else’s
            server. In open-wa that is the job of plugins. List them under <code>plugins</code> and configure
            them with <code>pluginConfig</code> in your <code>wa.config.*</code> file.<sup class="ref"><a href="#n3" id="r3" aria-label="Note 3">3</a></sup>
          </p>
          <aside class="note" id="n3" aria-label="Note 3">
            <span class="note__n">3</span>
            The Cloudflare session proxy gives remote access to a local session without opening public ports.
          </aside>

          <ol class="integrations" aria-label="Five integrations">
            <li><span class="label">01</span><b>Webhook</b><i>to your own server</i></li>
            <li><span class="label">02</span><b>Chatwoot</b><i>to the helpdesk</i></li>
            <li><span class="label">03</span><b>S3</b><i>to storage</i></li>
            <li><span class="label">04</span><b>Cloudflare</b><i>session proxy</i></li>
            <li><span class="label">05</span><b>Node-RED</b><i>to a flow</i></li>
          </ol>

          <p>
            And when the integration you need is not on that list, <code>@open-wa/plugin-sdk</code> is there
            so you can write your own.
          </p>
        </div>
      </section>

      <!-- ============ V ============ -->
      <section class="chapter" id="running" data-chapter="running" aria-labelledby="running-t">
        <header class="opener">
          <span class="opener__n" aria-hidden="true">V</span>
          <div>
            <p class="label">Chapter five</p>
            <h2 id="running-t">Running it well</h2>
            <p class="dek">Three habits for a bot that answers for months, not minutes.</p>
          </div>
        </header>

        <div class="body">
          <p class="drop">
            A bot that answers once is a demo. A bot that keeps answering needs a little housekeeping, and
            open-wa keeps it to three habits: name your sessions, lock the door, and choose your driver.
          </p>

          <h3 class="sub"><span class="label">i.</span> Name your sessions</h3>
          <p>
            Each session has a name and its own port, so sales and support can run side by side, each
            logged in once.
          </p>
          <figure class="fig">
            <div class="fig__plate">
              <pre><code set:html={hl(snippets.session, 'sh')} /></pre>
              <button class="copy" type="button" data-copy={snippets.session}>Copy</button>
            </div>
            <figcaption><span class="label">Fig. 6</span> A second session, named <i>sales</i>, on port 8081.</figcaption>
          </figure>

          <h3 class="sub"><span class="label">ii.</span> Lock the door</h3>
          <p>Set an API key before the API is reachable by anything but you.</p>
          <figure class="fig">
            <div class="fig__plate">
              <pre><code set:html={hl(snippets.apikey, 'sh')} /></pre>
              <button class="copy" type="button" data-copy={snippets.apikey}>Copy</button>
            </div>
            <figcaption><span class="label">Fig. 7</span> The same command, with a key.</figcaption>
          </figure>

          <h3 class="sub"><span class="label">iii.</span> Choose your driver</h3>
          <p>
            The embedded runtime drives a browser, and the driver is pluggable. Three ship today.
          </p>
          <ul class="drivers" aria-label="Browser drivers">
            <li>Puppeteer</li>
            <li>Playwright</li>
            <li>Lightpanda</li>
          </ul>

          <blockquote class="pull">
            <p class="pull__q">WhatsApp automation on your own infrastructure.</p>
            <footer class="label">The project, in its own words</footer>
          </blockquote>
        </div>
      </section>

      <!-- ============ VI ============ -->
      <section class="chapter chapter--note" id="licensing" data-chapter="licensing" aria-labelledby="lic-t">
        <header class="opener">
          <span class="opener__n" aria-hidden="true">VI</span>
          <div>
            <p class="label">Chapter six</p>
            <h2 id="lic-t">A note on licensing</h2>
          </div>
        </header>
        <div class="body">
          <div class="editors-note">
            <p class="label">Editor’s note</p>
            <p>
              open-wa is open source. Some methods need a <b>Restricted</b> or <b>Insiders</b> license, and the
              docs list which ones, so you can check before you build on them.
            </p>
            <p><a class="textlink" href={links.licensing}>See the licensed features <span aria-hidden="true">→</span></a></p>
          </div>
        </div>
      </section>

      <!-- ============ VII ============ -->
      <section class="chapter chapter--ultra" id="start" data-chapter="start" aria-labelledby="start-t">
        <header class="opener">
          <span class="opener__n" aria-hidden="true">VII</span>
          <div>
            <p class="label">Chapter seven</p>
            <h2 id="start-t">How to start</h2>
          </div>
        </header>
        <div class="body">
          <blockquote class="pull pull--last">
            <p class="pull__q">The most reliable WhatsApp automation library.</p>
            <footer class="label">The package description</footer>
          </blockquote>

          <ol class="steps">
            <li><span class="label">1</span><p>Install Node.js 22.21.1 or newer.</p></li>
            <li><span class="label">2</span><p>Run <code>npx @open-wa/wa-automate@latest --port 8080</code>.</p></li>
            <li><span class="label">3</span><p>Log in once, by QR code or link code.</p></li>
            <li><span class="label">4</span><p>Send your first message.</p></li>
          </ol>

          <div class="finale">
            <a class="btn btn--paper btn--lg" href={links.quickstart}>Send your first message <span aria-hidden="true">→</span></a>
            <ul class="finale__links">
              <li><a href={links.docs}>Read the docs</a></li>
              <li><a href={links.reference}>Client API reference</a></li>
              <li><a href={links.github}>Star it on GitHub <span class="label">3.6k</span></a></li>
              <li><a href={links.discord}>Join the Discord</a></li>
            </ul>
          </div>
        </div>
      </section>

      <footer class="colophon">
        <div>
          <p class="label">Colophon</p>
          <p>
            Set in Bodoni Moda for display, Newsreader for text and Fragment Mono for code. Figures are the
            project’s own commands. Numbers as of 8 October 2026.
          </p>
        </div>
        <div>
          <p class="label">Small print</p>
          <p>open-wa is unofficial and not affiliated with WhatsApp or Meta.</p>
        </div>
        <p class="colophon__mark" aria-hidden="true">open–wa</p>
      </footer>
    </main>

    <p class="sr-only" aria-live="polite" id="live"></p>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { SplitText } from 'gsap/SplitText';

      (window as any).__feature = true;
      const root = document.documentElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Scroll-linked progress rule (spine on desktop, running head on phone) ---- */
      let ticking = false;
      const setProgress = () => {
        const max = root.scrollHeight - innerHeight;
        root.style.setProperty('--p', String(max > 0 ? Math.min(1, scrollY / max) : 0));
        ticking = false;
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(setProgress); } }, { passive: true });
      addEventListener('resize', setProgress);
      setProgress();

      /* ---- Chapter index that tracks the reader ---- */
      const indexLinks = [...document.querySelectorAll<HTMLAnchorElement>('.index a')];
      const now = document.getElementById('menu-now')!;
      const setActive = (id: string | null) => {
        indexLinks.forEach((a) => {
          const on = a.dataset.for === id;
          a.classList.toggle('is-on', on);
          if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
        const hit = indexLinks.find((a) => a.dataset.for === id);
        now.textContent = hit ? hit.querySelector('.index__n')!.textContent! : 'Cover';
      };
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => { if (e.isIntersecting) setActive((e.target as HTMLElement).dataset.chapter ?? null); });
        },
        { rootMargin: '-45% 0px -54% 0px' },
      );
      document.querySelectorAll<HTMLElement>('[data-chapter]').forEach((s) => io.observe(s));
      new IntersectionObserver(
        ([e]) => { if (e.isIntersecting) setActive(null); },
        { rootMargin: '-45% 0px -54% 0px' },
      ).observe(document.getElementById('top')!);

      /* ---- Phone chapter menu ---- */
      const btn = document.getElementById('menu-btn') as HTMLButtonElement;
      const closeBtn = document.getElementById('menu-close') as HTMLButtonElement;
      const spine = document.getElementById('spine')!;
      const main = document.getElementById('main')!;
      const setMenu = (open: boolean) => {
        document.body.classList.toggle('menu-open', open);
        btn.setAttribute('aria-expanded', String(open));
        main.inert = open;
        if (open) (spine.querySelector('.index a') as HTMLElement)?.focus();
        else btn.focus({ preventScroll: true });
      };
      btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
      closeBtn.addEventListener('click', () => setMenu(false));
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && document.body.classList.contains('menu-open')) setMenu(false); });
      spine.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          if (document.body.classList.contains('menu-open')) {
            document.body.classList.remove('menu-open');
            btn.setAttribute('aria-expanded', 'false');
            main.inert = false;
          }
        }),
      );

      /* ---- Copy buttons on figures ---- */
      const live = document.getElementById('live')!;
      document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) =>
        b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy ?? '');
            b.textContent = 'Copied';
            live.textContent = 'Copied to clipboard';
          } catch {
            b.textContent = 'Select & copy';
          }
          setTimeout(() => { b.textContent = 'Copy'; }, 1800);
        }),
      );

      /* ---- Motion: type that comes into proof ----
         One language: lines rise out of their own baseline (expo.out, ~1.1s, 80ms line stagger),
         and display type sharpens from Bodoni's 6pt optical size to its 96pt cut as it lands. */
      if (!reduce) {
        gsap.registerPlugin(ScrollTrigger, SplitText);
        const fontsReady = Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1500))]);

        fontsReady.then(() => {
          const h1 = document.querySelector<HTMLElement>('.hero__title')!;
          const split = SplitText.create(h1, { type: 'lines,chars', mask: 'lines', linesClass: 'hl' });
          gsap.set(h1, { visibility: 'visible' });
          gsap
            .timeline({ defaults: { ease: 'expo.out' }, onComplete: () => split.revert() })
            .from(split.lines, { yPercent: 105, duration: 1.2, stagger: 0.09 })
            .fromTo(split.chars, { '--o': 6, '--w': 760 }, { '--o': 96, '--w': 460, duration: 1.5, stagger: 0.014, ease: 'power3.out' }, 0.1)
            .fromTo(h1, { '--u': 0 }, { '--u': 1, duration: 0.9, ease: 'power2.inOut' }, '-=0.6')
            .fromTo('.hero__kicker, .hero__copy > *, .numbers > div, .hero__fine', { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.06 }, 0.55);

          // Chapter numerals sharpen as they arrive.
          gsap.utils.toArray<HTMLElement>('.opener__n').forEach((n) => {
            gsap.fromTo(n, { '--o': 6, '--w': 900, yPercent: 30, autoAlpha: 0 }, {
              '--o': 96, '--w': 500, yPercent: 0, autoAlpha: 1, duration: 1.3, ease: 'expo.out',
              scrollTrigger: { trigger: n, start: 'top 88%', once: true },
            });
          });

          // Chapter titles: lines rise out of a mask.
          gsap.utils.toArray<HTMLElement>('.opener h2').forEach((h) => {
            SplitText.create(h, {
              type: 'lines', mask: 'lines', autoSplit: true,
              onSplit: (self) => gsap.from(self.lines, {
                yPercent: 105, duration: 1.1, stagger: 0.08, ease: 'expo.out',
                scrollTrigger: { trigger: h, start: 'top 88%', once: true },
              }),
            });
          });

          // Pull quotes: the same proofing, character by character.
          gsap.utils.toArray<HTMLElement>('.pull__q').forEach((q) => {
            const s = SplitText.create(q, { type: 'lines,chars', mask: 'lines' });
            gsap.timeline({
              scrollTrigger: { trigger: q, start: 'top 82%', once: true },
              onComplete: () => s.revert(),
            })
              .from(s.lines, { yPercent: 105, duration: 1.1, stagger: 0.08, ease: 'expo.out' })
              .fromTo(s.chars, { '--o': 6, '--w': 760 }, { '--o': 96, '--w': 420, duration: 1.2, stagger: 0.008, ease: 'power3.out' }, 0);
          });

          // Figures settle onto the page.
          gsap.utils.toArray<HTMLElement>('.fig, .integrations li, .drivers li, .steps li').forEach((f) => {
            gsap.from(f, {
              y: 18, autoAlpha: 0, duration: 0.9, ease: 'expo.out',
              scrollTrigger: { trigger: f, start: 'top 92%', once: true },
            });
          });
        });
      }
    </script>
  </body>
</html>
