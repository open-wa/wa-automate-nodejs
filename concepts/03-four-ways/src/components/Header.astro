---
import Mark from "./Mark.astro";
import { nav, links, href, starsShort, stats, base } from "../data/site";
const current = Astro.url.pathname;
const is = (p: string) => current.startsWith(href(p));
---
<header class="hdr" data-header>
  <div class="wrap hdr-row">
    <a class="mark-host brand" href={base} aria-label="open-wa home"><Mark size={30} label="" /><span>open-wa</span></a>

    <nav class="hdr-nav" aria-label="Main">
      <ul>
        <li class="has-mega">
          <button type="button" class="nav-link" aria-expanded="false" aria-controls="mega-product" data-mega-btn>
            Product <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <div class="mega" id="mega-product" hidden data-mega>
            <div class="mega-grid">
              <div class="mega-col mega-ways">
                <p class="mega-title">Four ways in</p>
                <ul>
                  {nav.paths.map((l, i) => (
                    <li><a href={l.href}><span class="mega-glyph" data-glyph={i}></span><span><strong>{l.label}</strong><small>{l.note}</small></span></a></li>
                  ))}
                </ul>
              </div>
              <div class="mega-col">
                <p class="mega-title">Product</p>
                <ul>{nav.product.map((l) => <li><a href={l.href}><strong>{l.label}</strong><small>{l.note}</small></a></li>)}</ul>
              </div>
              <div class="mega-col">
                <p class="mega-title">Decide</p>
                <ul>{nav.decide.map((l) => <li><a href={l.href}><strong>{l.label}</strong><small>{l.note}</small></a></li>)}</ul>
              </div>
            </div>
          </div>
        </li>
        <li><a class="nav-link" href={href("integrations/")} aria-current={is("integrations/") ? "page" : undefined}>Integrations</a></li>
        <li><a class="nav-link" href={links.docs}>Docs <span aria-hidden="true" class="ext">↗</span></a></li>
        <li><a class="nav-link" href={href("pricing/")} aria-current={is("pricing/") ? "page" : undefined}>Pricing</a></li>
      </ul>
    </nav>

    <div class="hdr-end">
      <a class="nav-link gh" href={links.github} title={`${stats.githubStars.toLocaleString("en-GB")} GitHub stars, checked ${stats.checkedOn}`}>
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <span><span class="visually-hidden">GitHub, </span>{starsShort}<span class="visually-hidden"> stars</span></span>
      </a>
      <a class="nav-link discord" href={links.discord}>Discord</a>
      <a class="btn btn-primary hdr-cta" href={href("quickstart/")}>Quick start</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="sheet" data-sheet-btn>
        <span class="visually-hidden">Menu</span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div class="sheet" id="sheet" hidden data-sheet>
    <div class="wrap sheet-inner">
      <p class="mega-title">Four ways in</p>
      <ul class="sheet-list">{nav.paths.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      <p class="mega-title">Product</p>
      <ul class="sheet-list">
        {nav.product.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={href("pricing/")}>Pricing</a></li>
        <li><a href={href("compare/")}>Official API or open-wa?</a></li>
      </ul>
      <p class="mega-title">Developers</p>
      <ul class="sheet-list">
        <li><a href={links.docs}>Docs ↗</a></li>
        <li><a href={href("migrate/")}>Migrate from v4</a></li>
        <li><a href={href("changelog/")}>Changelog</a></li>
        <li><a href={href("support/")}>Support and consulting</a></li>
        <li><a href={links.github}>GitHub ({starsShort} stars)</a></li>
        <li><a href={links.discord}>Discord</a></li>
      </ul>
      <a class="btn btn-primary sheet-cta" href={href("quickstart/")}>Quick start</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const btn = header.querySelector<HTMLButtonElement>("[data-mega-btn]")!;
  const mega = header.querySelector<HTMLElement>("[data-mega]")!;
  const sheetBtn = header.querySelector<HTMLButtonElement>("[data-sheet-btn]")!;
  const sheet = header.querySelector<HTMLElement>("[data-sheet]")!;
  let closeTimer = 0;
  const setMega = (open: boolean) => {
    btn.setAttribute("aria-expanded", String(open));
    mega.hidden = !open;
    header.toggleAttribute("data-open", open);
  };
  btn.addEventListener("click", () => setMega(btn.getAttribute("aria-expanded") !== "true"));
  const li = btn.parentElement!;
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  li.addEventListener("mouseenter", () => { if (fine.matches) { clearTimeout(closeTimer); setMega(true); } });
  li.addEventListener("mouseleave", () => { if (fine.matches) closeTimer = window.setTimeout(() => setMega(false), 160); });
  li.addEventListener("focusout", (e) => { if (!li.contains(e.relatedTarget as Node)) setMega(false); });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (!mega.hidden) { setMega(false); btn.focus(); }
    if (!sheet.hidden) { setSheet(false); sheetBtn.focus(); }
  });
  document.addEventListener("click", (e) => { if (!li.contains(e.target as Node)) setMega(false); });
  const setSheet = (open: boolean) => {
    sheetBtn.setAttribute("aria-expanded", String(open));
    sheet.hidden = !open;
    document.documentElement.toggleAttribute("data-sheet-open", open);
    sheetBtn.querySelector(".visually-hidden")!.textContent = open ? "Close menu" : "Menu";
  };
  sheetBtn.addEventListener("click", () => setSheet(sheet.hidden));
  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--color-bg) 92%, transparent); backdrop-filter: saturate(1.2) blur(8px); border-bottom: 1px solid transparent; transition: border-color var(--speed); }
  .hdr[data-scrolled], .hdr[data-open] { border-bottom-color: var(--color-rule); }
  .hdr-row { display: flex; align-items: center; gap: 24px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 600 19px/1 var(--font-display); letter-spacing: -0.01em; min-height: 44px; font-variation-settings: "opsz" 24; }
  .brand span { font-size: 21px; }
  .hdr-nav ul { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: 999px; font: 500 15.5px/1 var(--font-text); color: var(--color-ink); text-decoration: none; background: none; border: 0; cursor: pointer; }
  .nav-link:hover, .nav-link[aria-expanded="true"] { background: var(--color-paper-2); }
  .nav-link[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--color-coral); text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .nav-link svg { transition: transform var(--speed) var(--ease); }
  .nav-link[aria-expanded="true"] svg { transform: rotate(180deg); }
  .ext { font-size: 12px; color: var(--color-muted); }
  .hdr-end { display: flex; align-items: center; gap: 4px; margin-left: auto; }
  .gh span { font-family: var(--font-mono); font-size: 13.5px; }
  .hdr-cta { margin-left: 8px; min-height: 42px; padding: 0 18px; font-size: 15px; }
  .has-mega { position: static; }
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--color-paper-3); border-bottom: 1px solid var(--color-rule); box-shadow: 0 24px 48px -24px rgba(20, 33, 61, 0.25); animation: mega-in 200ms var(--ease); }
  @keyframes mega-in { from { opacity: 0; transform: translateY(-6px); } }
  .mega-grid { max-width: calc(var(--max) + 2 * var(--gutter)); margin: 0 auto; padding: 28px var(--gutter) 32px; display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; }
  .mega-title { font: 500 12.5px/1 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 14px; }
  .mega ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .mega a { display: flex; gap: 14px; align-items: flex-start; padding: 10px 12px; margin: 0 -12px; border-radius: 8px; text-decoration: none; }
  .mega a:hover, .mega a:focus-visible { background: var(--color-paper-2); }
  .mega a > span:last-child, .mega-col:not(.mega-ways) a { display: grid; gap: 2px; }
  .mega strong { font-weight: 600; font-size: 16px; }
  .mega small { font-size: 14.5px; color: var(--color-muted); }
  .mega-glyph { flex: none; width: 34px; height: 34px; border-radius: 8px; background: var(--color-ink); position: relative; }
  .mega-glyph::before { content: ""; position: absolute; left: 8px; right: 8px; top: 50%; height: 2px; background: var(--color-coral); transform: translateY(-50%); }
  .mega-glyph::after { content: ""; position: absolute; right: 6px; top: 50%; width: 8px; height: 8px; border-radius: 50%; background: var(--color-brass); transform: translateY(-50%); }
  .mega-glyph[data-glyph="1"]::before { top: 40%; } .mega-glyph[data-glyph="1"]::after { top: 62%; }
  .mega-glyph[data-glyph="2"]::after { right: auto; left: 13px; }
  .mega-glyph[data-glyph="3"]::after { border-radius: 2px; }
  .menu-btn { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; border: 1px solid var(--color-rule); border-radius: 999px; background: transparent; color: var(--color-ink); cursor: pointer; }
  .sheet { border-top: 1px solid var(--color-rule); background: var(--color-bg); max-height: calc(100dvh - 64px); overflow-y: auto; }
  .sheet-inner { padding-top: 20px; padding-bottom: 28px; }
  .sheet-list { list-style: none; margin: 0 0 22px; padding: 0; border-top: 1px solid var(--color-rule); }
  .sheet-list a { display: flex; align-items: center; min-height: 48px; border-bottom: 1px solid var(--color-rule); text-decoration: none; font-size: 17px; }
  .sheet-cta { width: 100%; }
  @media (max-width: 1020px) {
    .hdr-nav, .discord { display: none; }
    .menu-btn { display: inline-flex; }
  }
  @media (max-width: 560px) {
    .hdr-cta, .gh { display: none; }
  }
</style>
