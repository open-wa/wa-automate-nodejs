---
import CopyButton from "./CopyButton.astro";
import { commands, links, latest, href, product } from "../data/site";
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy">
      <a class="release" href={href("changelog/")}><span class="mono">v{latest.version.replace(/\.0$/, "")}</span> {latest.headline} <span aria-hidden="true">→</span></a>
      <h1 id="hero-title">Plug your own WhatsApp number into your Node.js&nbsp;app.</h1>
    </div>
    <div class="hero-sub">
      <p class="sub">open-wa runs WhatsApp Web for you and hands your code the account's chats, messages and events, as an HTTP API, a client, an embedded runtime or an MCP server. Free for most methods.</p>
      <p class="note small muted">Unofficial and unaffiliated with WhatsApp. Automation can get an account banned. <a class="link" href={href("legal/#risk")}>Read the risk note</a>.</p>
    </div>
    <div class="hero-run">
      <p class="run-label" id="run-label">Run it with Node.js 22 or later</p>
      <div class="cmd" role="group" aria-labelledby="run-label">
        <span class="prompt" aria-hidden="true">$</span>
        <code id="hero-cmd">{commands.easyApi}</code>
        <CopyButton target="hero-cmd" describe="the run command" />
      </div>
      <div class="ctas">
        <a class="btn btn-primary" href={href("quickstart/")}>Quick start <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={links.docs}>Read the docs</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(28px, 6vw, 72px) 0 clamp(36px, 5vw, 56px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "copy copy" "sub run"; column-gap: clamp(24px, 5vw, 72px); row-gap: 28px; align-items: start; }
  .hero-copy { grid-area: copy; display: grid; gap: 22px; }
  .hero-sub { grid-area: sub; display: grid; gap: 14px; align-content: start; }
  .hero-run { grid-area: run; }
  .release { justify-self: start; display: inline-flex; align-items: center; gap: 10px; min-height: 36px; padding: 0 14px 0 6px; border: 1px solid var(--color-rule); border-radius: 999px; text-decoration: none; font-size: 14.5px; color: var(--color-ink); background: var(--color-paper-3); }
  .release .mono { font-size: 12px; background: var(--color-ink); color: var(--color-bg); padding: 5px 9px; border-radius: 999px; }
  .release:hover { border-color: var(--color-ink); }
  h1 { max-width: 19ch; font-weight: 450; }
  .sub { font-size: clamp(17px, 1.6vw, 20px); color: var(--color-muted); max-width: 54ch; }
  .hero-run { display: grid; gap: 14px; }
  .run-label { font: 500 13px/1 var(--font-mono); color: var(--color-muted); letter-spacing: 0.02em; }
  .cmd { display: flex; align-items: center; gap: 10px; background: var(--color-ink); color: var(--color-on-navy); border-radius: 14px; padding: 8px 8px 8px 18px; min-width: 0; box-shadow: 0 18px 40px -26px rgba(20, 33, 61, 0.7); }
  .prompt { font-family: var(--font-mono); color: var(--color-coral); font-size: 14px; }
  .cmd code { background: none; padding: 0; color: inherit; font-size: 14px; white-space: nowrap; overflow-x: auto; flex: 1; min-width: 0; scrollbar-width: none; }
  .cmd code::-webkit-scrollbar { display: none; }
  .cmd :global(.copy) { background: var(--color-coral); color: var(--color-ink); border-color: var(--color-coral); }
  .cmd :global(.copy:hover) { background: #ff8466; }
  .cmd :global(.copy[data-copied]) { background: var(--color-on-navy); border-color: var(--color-on-navy) !important; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .note { max-width: 46ch; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "sub" "run"; row-gap: 20px; }
    h1 { max-width: 15ch; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 16px; }
    .hero-copy { gap: 14px; }
    .release { display: none; }
    h1 { font-size: 36px; line-height: 1.06; }
    .sub { font-size: 16.5px; line-height: 1.5; }
    .run-label { display: none; }
    .cmd { padding-left: 14px; gap: 8px; }
    .cmd code { font-size: 12.5px; }
    .ctas .btn { flex: 1; padding: 0 14px; }
    .note { display: none; }
  }
</style>
