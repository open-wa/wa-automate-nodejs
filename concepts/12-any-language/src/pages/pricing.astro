---
import Site from "../layouts/Site.astro";
import LicenceForm from "../components/LicenceForm.astro";
import CopyCommand from "../components/CopyCommand.astro";
import { f, tiers, priceNote, href, S } from "../data/facts";
import { byJob } from "../data/pricing";
const periods: [keyof typeof tiers[0]["prices"], string][] = [["month", "1 month"], ["threeMonths", "3 months"], ["sixMonths", "6 months"], ["year", "1 year"]];
const faqs = [
  ["Do I need a key to start?", "No. The library is free, and every method marked none works without a key: replying to people who message you, media, polls, events, webhooks and MCP for those methods."],
  ["Is a key per number or per server?", "Per WhatsApp number. You pass it when the session starts with --license-key, or apply it from the dashboard or client.refresh() without restarting."],
  ["Why does OTP need Restricted?", "Codes go to numbers that haven't messaged your number before. Starting a conversation with a number that isn't already a contact is a Restricted method."],
  ["What about calls?", "Calling is a licensed preview and needs a calling-enabled key. Audio only; camera calls are in development. Ask on Discord or by email before buying."],
  ["Which tier do I need?", "Name the exact method your workflow needs, then check its tier in the table above or in the method list at /api-docs/ on your running instance."],
  ["Does a key lower ban risk?", "No. A key enables licensed methods. " + f.product.risk],
];
---
<Site title="Pricing: which WhatsApp jobs need a key | open-wa" description="open-wa is free for replying, media, polls and events. OTP and first messages need Restricted (£15 a month); buttons and lists need Insiders (£5 a month). Keys are per number.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Pricing</p>
      <h1>Free to reply. A key per number for the jobs that need one.</h1>
      <p class="lead">Most methods need no key. Insiders and Restricted keys unlock specific methods for one WhatsApp number. {priceNote}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="tiers">
        <article class="tier">
          <h2>No key</h2>
          <p class="tier-price">£0</p>
          <p>{f.licences.free.covers}</p>
          <CopyCommand cmd={f.commands.easyApi} />
        </article>
        {tiers.map((t) => (
          <article class:list={["tier", t.id === "restricted" && "tier-hl"]}>
            <h2>{t.name}</h2>
            <p class="tier-price">{t.prices.month}<span> a month</span></p>
            <ul class="tier-periods">
              {periods.map(([k, l]) => <li><span>{l}</span><b>{t.prices[k]}</b></li>)}
            </ul>
            <p>{t.unlocks.replace(/^Everything in Insiders, plus/u, "Everything in Insiders, and")}</p>
            <a class="btn btn-red" href={`${href("pricing/")}?tier=${t.id}#licence`}>Get {t.name}</a>
          </article>
        ))}
      </div>
      <p class="fine">{f.licences.pricesCheckedOn} Calling needs a calling-enabled key (licensed preview); ask before buying.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2 class="h2">By job</h2>
      <div class="bj">
        {byJob.map((r) => (
          <div class="bj-row"><b>{r.job}</b><span class="bj-m">{r.methods.map((m) => <code>{m}</code>)}</span><span class:list={["pill", r.tier !== "none" && "pill-red"]}>{r.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-paper" id="licence">
    <div class="wrap lic-grid">
      <div>
        <p class="kicker">Get a licence key</p>
        <h2 class="h2">Four details, then a prefilled checkout</h2>
        <p class="lead">{f.licences.checkoutFlow}</p>
        <h3 class="bfy">Before you buy</h3>
        <ol class="bfy-list">{f.licences.beforeYouBuy.map((b) => <li>{b}</li>)}</ol>
        <p class="risk"><strong>Ban risk:</strong> {f.product.risk}</p>
      </div>
      <LicenceForm />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2 class="h2">Questions</h2>
      <div class="faq">
        {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
      <p class="fine-d">Need it built for you? <a href={href("support/")}>Consulting and support</a>. Licence docs: <a href={S.licensingDocs}>openwa.dev/docs/licensing</a>.</p>
    </div>
  </section>
</Site>
<style>
  .tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tier { display: grid; gap: 14px; align-content: start; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--navy-2); min-width: 0; }
  .tier-hl { border-color: var(--red); }
  .tier h2 { font-size: 24px; }
  .tier p { margin: 0; color: #d9dbe5; }
  .tier .tier-price { font: 700 44px var(--font-display); color: var(--paper); letter-spacing: -0.03em; }
  .tier-price span { font: 500 17px var(--font-text); color: var(--muted); letter-spacing: 0; }
  .tier-periods { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .tier-periods li { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .tier-periods b { font-family: var(--font-mono); }
  .fine { color: var(--muted); font-size: 16px; margin: 20px 0 0; }
  .bj { margin-top: 28px; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .bj-row { display: grid; grid-template-columns: 1.3fr 1.3fr auto; gap: 16px; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .bj-row:last-child { border-bottom: 0; }
  .bj-m { display: flex; flex-wrap: wrap; gap: 6px; }
  .bj-m code { font-size: 13.5px; color: var(--sky); }
  .lic-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .bfy { font-size: 20px; margin: 28px 0 8px; }
  .bfy-list { padding-left: 20px; margin: 0 0 24px; color: var(--muted-paper); }
  .faq { margin-top: 24px; display: grid; gap: 8px; max-width: 820px; }
  .faq details { border: 1px solid var(--line); border-radius: 12px; padding: 0 18px; background: var(--navy-2); }
  .faq summary { cursor: pointer; font-weight: 700; padding: 14px 0; min-height: 44px; }
  .faq p { margin: 0 0 16px; color: #d9dbe5; }
  .fine-d { margin-top: 24px; color: var(--muted); }
  @media (max-width: 960px) { .tiers, .lic-grid { grid-template-columns: 1fr; } .bj-row { grid-template-columns: 1fr; gap: 6px; } }
</style>
