---
/**
 * Signature moment: pick a job and a language, see the exact request, its
 * response and the result replayed on a drawn phone. Every panel is rendered
 * at build time with Shiki; the script only switches which one shows and
 * replays the animation. Reduced motion or ?still: no replay, settled frames.
 */
import CodeBlock from "./CodeBlock.astro";
import { bjobs, langs, URL_SEND, responseJson } from "../data/builder";
import { href, f } from "../data/facts";
const first = bjobs[0];
---
<div class="rb" data-rb data-job="booking" data-lang="curl">
  <div class="rb-win">
    <div class="rb-top">
      <span class="rb-tab"><span class="rb-dot" aria-hidden="true"></span>localhost:8080</span>
      <span class="rb-ex">Example output. Run the command above to make it real.</span>
    </div>
    <div class="rb-body">
      <div class="rb-jobs" role="group" aria-label="Pick a job">
        <p class="rb-h">Jobs</p>
        <div class="rb-jobs-list">
          {bjobs.map((j, i) => (
            <button type="button" class="rb-job" data-job={j.id} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="rb-job-m">{j.method}</span>
              <span class="rb-job-l">{j.label}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="rb-req">
        <div class="rb-langs" role="tablist" aria-label="Language">
          {langs.map((l, i) => (
            <button type="button" role="tab" class="rb-lang" data-lang={l.id} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} aria-controls="rb-panels">{l.label}</button>
          ))}
        </div>

        <div class="rb-url" data-show="http">
          <span class="rb-verb">POST</span>
          <span class="rb-path"><span class="rb-host">localhost:8080</span>/api/messages/sendText</span>
          <button type="button" class="rb-send" data-send>Send</button>
        </div>
        {bjobs.filter((j) => !j.http).map((j) => (
          <div class="rb-url rb-url-js" data-show={`js:${j.id}`} hidden>
            <span class="rb-verb rb-verb-js">JS</span>
            <span class="rb-path">client.{j.method}()</span>
            <button type="button" class="rb-send" data-send>Run</button>
          </div>
        ))}

        <div class="rb-panels" id="rb-panels" role="tabpanel" aria-live="polite">
          {bjobs.filter((j) => j.http).map((j) => langs.map((l) => (
            <div class="rb-panel" data-panel={`${j.id}:${l.id}`} hidden={!(j.id === first.id && l.id === "curl")}>
              {l.id === "n8n" ? (
                <div class="n8n">
                  <p class="n8n-h">HTTP Request node</p>
                  <dl class="n8n-f">
                    <div><dt>Method</dt><dd>POST</dd></div>
                    <div><dt>URL</dt><dd class="mono">{URL_SEND}</dd></div>
                    <div><dt>Send Headers</dt><dd class="mono">X-API-Key: your-secure-key</dd></div>
                    <div><dt>Send Body</dt><dd>JSON</dd></div>
                  </dl>
                  <CodeBlock code={j.code.n8n} lang="json" title="JSON body (expression)" />
                </div>
              ) : (
                <CodeBlock code={j.code[l.id]} lang={l.shiki} title={`${l.label}: ${j.label.toLowerCase()}`} />
              )}
            </div>
          )))}
          {bjobs.filter((j) => !j.http).map((j) => (
            <div class="rb-panel" data-panel={`${j.id}:*`} hidden>
              <p class="rb-note" data-note>
                <strong>{j.method}</strong> is an HTTP endpoint on your running instance too, but this page only prints routes we document.
                Every method is listed at <code>/api-docs/</code> on your running instance, and <code>/meta/postman.json</code> imports into Postman.
                Here it is in Node.js:
              </p>
              <CodeBlock code={j.js!} lang="js" title={`Node.js: ${j.label.toLowerCase()}`} />
            </div>
          ))}
        </div>

        <div class="rb-res" data-show="http">
          <div class="rb-res-bar"><span>Response</span><span class="pill pill-ok">200 OK</span></div>
          <pre class="rb-res-body"><code>{responseJson}</code></pre>
          <p class="rb-res-note"><code>data</code> holds what sendText returned. Example output.</p>
        </div>

        {bjobs.map((j, i) => (
          <p class:list={["rb-lic", `rb-lic-${j.licenceTone}`]} data-lic={j.id} hidden={i !== 0}>
            <span class:list={["pill", j.licenceTone === "paid" ? "pill-red" : "pill-free"]}>{j.licenceTone === "paid" ? "Key needed" : "Free"}</span>
            <span>{j.licence} <a href={href(`recipes/${j.recipe}/`)}>Full recipe</a></span>
          </p>
        ))}
      </div>

      <div class="rb-phone-wrap">
        <div class="phone" data-phone aria-label="Drawn phone showing the result. Example output." role="img">
          <div class="ph-screen">
            <div class="ph-status" aria-hidden="true"><span>13:02</span><span class="ph-island"></span><span>5G</span></div>

            <div class="ph-view" data-view="booking">
              <div class="ph-head"><span class="ph-av">RS</span><span><b>Rosa's Salon</b><small>Example business</small></span></div>
              <div class="ph-chat">
                <p class="ph-day">Today</p>
                <div class="msg msg-me" style="--d:0ms">Can I book a cut on Friday afternoon?<span class="msg-t">13:01</span></div>
                <div class="msg-typing" style="--d:350ms" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="msg msg-biz" style="--d:1000ms">Hi Sam, your cut with Rosa is booked for Friday at 13:30. Reply here if you need to move it.<span class="msg-t">13:02</span></div>
              </div>
            </div>

            <div class="ph-view" data-view="otp" hidden>
              <div class="ph-head"><span class="ph-av ph-av-2">A</span><span><b>Acme</b><small>Example business</small></span></div>
              <div class="ph-chat">
                <p class="ph-day">Today</p>
                <div class="msg-typing" style="--d:0ms" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="msg msg-biz msg-otp" style="--d:600ms">Your Acme code is <span class="otp">482913</span>. It expires in 10 minutes.<span class="msg-t">13:02</span></div>
              </div>
              <div class="ph-field" style="--d:1300ms"><span>Enter code</span><b class="mono">4 8 2 9 1 3</b></div>
            </div>

            <div class="ph-view" data-view="pdf" hidden>
              <div class="ph-head"><span class="ph-av ph-av-3">HH</span><span><b>Harbour House</b><small>Example business</small></span></div>
              <div class="ph-chat">
                <p class="ph-day">Today</p>
                <div class="msg-typing" style="--d:0ms" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="msg msg-biz msg-doc" style="--d:600ms">
                  <span class="doc"><span class="doc-ic" aria-hidden="true">PDF</span><span><b>booking-HH2291.pdf</b><small>1 page</small></span></span>
                  Your booking confirmation<span class="msg-t">13:02</span>
                </div>
              </div>
            </div>

            <div class="ph-view ph-call" data-view="call" hidden>
              <div class="call-av" aria-hidden="true"><span>RS</span></div>
              <b class="call-name">Rosa's Salon</b>
              <small class="call-sub">Example business</small>
              <p class="call-state"><span class="cs-ring">Ringing</span><span class="cs-on">Connected 0:04</span></p>
              <div class="wave" aria-hidden="true">{Array.from({ length: 22 }).map((_, i) => <i style={`--i:${i}`}></i>)}</div>
              <p class="call-note">Playing greeting.wav<br />Recording to received.wav</p>
              <div class="call-btns" aria-hidden="true"><span class="cb"></span><span class="cb cb-end"></span><span class="cb"></span></div>
            </div>
          </div>
        </div>
        <p class="ph-cap">The phone shows what your customer sees.</p>
      </div>
    </div>
  </div>
</div>

<script>
  import { shouldAnimate } from "../lib/runtime";
  const root = document.querySelector<HTMLElement>("[data-rb]");
  if (root) {
    const httpJobs = new Set(["booking", "otp"]);
    const params = new URLSearchParams(location.search);
    let job = params.get("job") ?? "booking";
    let lang = params.get("lang") ?? "curl";
    const q = <T extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<T & HTMLElement>(s));
    const phone = root.querySelector<HTMLElement>("[data-phone]")!;

    const replay = () => {
      if (!shouldAnimate()) return;
      phone.classList.remove("play");
      void phone.offsetWidth;
      phone.classList.add("play");
    };

    const render = (animate: boolean) => {
      if (!q(`.rb-job[data-job="${job}"]`).length) job = "booking";
      if (!q(`.rb-lang[data-lang="${lang}"]`).length) lang = "curl";
      root.dataset.job = job; root.dataset.lang = lang;
      const isHttp = httpJobs.has(job);
      q(".rb-job").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.job === job)));
      q(".rb-lang").forEach((b) => { const on = b.dataset.lang === lang; b.setAttribute("aria-selected", String(on)); b.tabIndex = on ? 0 : -1; });
      q("[data-show]").forEach((el) => { const s = el.dataset.show; el.hidden = !(s === "http" ? isHttp : s === `js:${job}`); });
      let shown: HTMLElement | null = null;
      q(".rb-panel").forEach((p) => {
        const on = p.dataset.panel === `${job}:${lang}` || p.dataset.panel === `${job}:*`;
        p.hidden = !on; if (on) shown = p;
      });
      if (shown) {
        const note = (shown as HTMLElement).querySelector<HTMLElement>("[data-note]");
        if (note) note.hidden = lang === "node";
      }
      q("[data-lic]").forEach((p) => (p.hidden = p.dataset.lic !== job));
      q("[data-view]").forEach((v) => (v.hidden = v.dataset.view !== job));
      if (animate && shown && shouldAnimate()) {
        const panel = shown as HTMLElement;
        panel.querySelectorAll<HTMLElement>(".line").forEach((l, i) => l.style.setProperty("--i", String(Math.min(i, 24))));
        panel.classList.remove("typing"); void panel.offsetWidth; panel.classList.add("typing");
        replay();
      }
    };

    q(".rb-job").forEach((b) => b.addEventListener("click", () => { job = b.dataset.job!; render(true); }));
    const tabs = q<HTMLButtonElement>(".rb-lang");
    tabs.forEach((b, i) => {
      b.addEventListener("click", () => { lang = b.dataset.lang!; render(true); });
      b.addEventListener("keydown", (e) => {
        const k = (e as KeyboardEvent).key;
        const d = k === "ArrowRight" ? 1 : k === "ArrowLeft" ? -1 : 0;
        if (!d && k !== "Home" && k !== "End") return;
        e.preventDefault();
        const n = k === "Home" ? 0 : k === "End" ? tabs.length - 1 : (i + d + tabs.length) % tabs.length;
        tabs[n].focus(); lang = tabs[n].dataset.lang!; render(true);
      });
    });
    q("[data-send]").forEach((b) => b.addEventListener("click", () => {
      replay();
      const res = root.querySelector<HTMLElement>(".rb-res");
      if (res && shouldAnimate()) { res.classList.remove("flash"); void res.offsetWidth; res.classList.add("flash"); }
    }));
    render(false);
    // First visit: play the result once when the builder scrolls into view.
    if (shouldAnimate()) {
      const io = new IntersectionObserver(([e]) => { if (e?.isIntersecting) { replay(); io.disconnect(); } }, { threshold: 0.35 });
      io.observe(phone);
    }
  }
</script>

<style>
  .rb-win { border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--navy-2); overflow: hidden; box-shadow: 0 40px 80px -40px rgba(0,0,0,.7); }
  .rb-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--line); background: #0d1328; }
  .rb-tab { display: inline-flex; align-items: center; gap: 8px; font: 500 14px var(--font-mono); color: var(--paper); padding: 4px 10px; border: 1px solid var(--line); border-radius: 7px; }
  .rb-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 25%, transparent); }
  .rb-ex { font-size: 14px; color: var(--muted); }
  .rb-body { display: grid; grid-template-columns: 230px minmax(0, 1fr) 320px; }
  .rb-jobs { border-right: 1px solid var(--line); padding: 16px 12px; }
  .rb-h { font: 600 13px var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 0 6px 10px; }
  .rb-jobs-list { display: grid; gap: 4px; }
  .rb-job { text-align: left; display: grid; gap: 2px; padding: 10px 12px; min-height: 44px; border-radius: 9px; border: 1px solid transparent; background: transparent; color: var(--paper); cursor: pointer; font: inherit; }
  .rb-job:hover { background: var(--navy-3); }
  .rb-job[aria-pressed="true"] { background: var(--navy-3); border-color: var(--red); }
  .rb-job-m { font: 500 13px var(--font-mono); color: var(--red); }
  .rb-job-l { font-weight: 700; font-size: 16px; line-height: 1.3; }

  .rb-req { padding: 16px; display: grid; gap: 14px; align-content: start; min-width: 0; }
  .rb-langs { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--line); }
  .rb-lang { flex: none; min-height: 44px; padding: 0 14px; background: transparent; border: 0; border-bottom: 2px solid transparent; color: var(--muted); font: 600 15px var(--font-text); cursor: pointer; margin-bottom: -1px; }
  .rb-lang:hover { color: var(--paper); }
  .rb-lang[aria-selected="true"] { color: var(--paper); border-bottom-color: var(--red); }
  .rb-url { display: flex; align-items: stretch; border: 1px solid var(--line); border-radius: var(--radius); background: #0a1024; min-width: 0; }
  .rb-verb { display: grid; place-items: center; padding: 0 12px; font: 700 14px var(--font-mono); color: var(--red); border-right: 1px solid var(--line); }
  .rb-verb-js { color: var(--sky); }
  .rb-path { flex: 1; min-width: 0; padding: 12px; font: 400 15px var(--font-mono); color: var(--paper); overflow-wrap: anywhere; }
  .rb-host { color: var(--muted); }
  .rb-send { flex: none; min-width: 76px; border: 0; background: var(--red); color: var(--navy); font: 700 15px var(--font-text); cursor: pointer; border-radius: 0 var(--radius) var(--radius) 0; }
  .rb-send:hover { background: #ff6a5c; }
  .rb-panels { min-width: 0; }
  .rb-panel :global(pre) { max-height: 360px; }
  .rb-note { margin: 0 0 12px; font-size: 16px; color: #d9dbe5; }
  .rb-note code { color: var(--peach); }
  .n8n { display: grid; gap: 12px; }
  .n8n-h { margin: 0; font: 700 15px var(--font-text); }
  .n8n-f { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .n8n-f div { display: grid; grid-template-columns: 130px 1fr; border-bottom: 1px solid var(--line); }
  .n8n-f div:last-child { border-bottom: 0; }
  .n8n-f dt { padding: 10px 12px; color: var(--muted); font-size: 15px; background: #0d1328; }
  .n8n-f dd { margin: 0; padding: 10px 12px; font-size: 15px; overflow-wrap: anywhere; min-width: 0; }
  .rb-res { border: 1px solid var(--line); border-radius: var(--radius); background: #0a1024; }
  .rb-res-bar { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--line); font: 600 14px var(--font-mono); color: var(--muted); }
  .rb-res-body { margin: 0; padding: 12px 14px; font: 15px/1.5 var(--font-mono); color: var(--peach); }
  .rb-res-note { margin: 0; padding: 0 14px 12px; font-size: 15px; color: var(--muted); }
  .rb-res.flash { animation: flash 700ms var(--ease); }
  @keyframes flash { 0% { border-color: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent); } 100% { border-color: var(--line); box-shadow: none; } }
  .rb-lic { display: flex; gap: 10px; align-items: baseline; margin: 0; font-size: 16px; color: #d9dbe5; }
  .rb-lic .pill { flex: none; }
  .rb-lic a { color: var(--paper); }

  .typing :global(.line) { animation: lineIn 280ms calc(var(--i, 0) * 26ms) var(--ease) both; }
  @keyframes lineIn { from { opacity: 0; transform: translateX(-6px); filter: blur(2px); } to { opacity: 1; transform: none; filter: none; } }

  /* The drawn phone */
  .rb-phone-wrap { border-left: 1px solid var(--line); padding: 20px; display: grid; justify-items: center; align-content: start; gap: 10px; background: radial-gradient(120% 70% at 50% 0%, #1b2650 0%, transparent 70%); }
  .phone { width: 270px; height: 540px; border-radius: 42px; padding: 9px; background: #1d2440; box-shadow: inset 0 0 0 1.5px #3a4570, 0 30px 60px -20px rgba(0,0,0,.7); }
  .ph-screen { height: 100%; border-radius: 34px; overflow: hidden; background: var(--paper); color: var(--ink); display: flex; flex-direction: column; position: relative; }
  .ph-status { display: flex; justify-content: space-between; align-items: center; padding: 10px 22px 4px; font: 700 12px var(--font-text); }
  .ph-island { width: 74px; height: 20px; border-radius: 12px; background: var(--navy); }
  .ph-view { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .ph-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid #ddd6c6; }
  .ph-head b { display: block; font: 700 15px var(--font-display); }
  .ph-head small { display: block; font-size: 12px; color: var(--muted-paper); }
  .ph-av { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--red); color: var(--navy); font: 800 12px var(--font-display); }
  .ph-av-2 { background: var(--navy); color: var(--paper); }
  .ph-av-3 { background: #2c4a7a; color: var(--paper); }
  .ph-chat { flex: 1; padding: 12px; display: flex; flex-direction: column; gap: 8px; background-image: radial-gradient(#e2dccd 1px, transparent 1px); background-size: 14px 14px; }
  .ph-day { align-self: center; margin: 0 0 4px; font: 600 11px var(--font-text); color: var(--muted-paper); background: var(--paper-2); padding: 2px 8px; border-radius: 6px; }
  .msg { max-width: 86%; padding: 9px 11px 18px; font-size: 14px; line-height: 1.4; position: relative; border-radius: 14px; }
  .msg-me { align-self: flex-end; background: #fff; border: 1px solid #ddd6c6; border-bottom-right-radius: 4px; }
  .msg-biz { align-self: flex-start; background: var(--navy); color: var(--paper); border-bottom-left-radius: 4px; }
  .msg-t { position: absolute; right: 10px; bottom: 4px; font-size: 10.5px; opacity: .7; }
  .msg-typing { display: none; }
  .otp { font: 700 15px var(--font-mono); background: var(--red); color: var(--navy); padding: 0 5px; border-radius: 4px; letter-spacing: .05em; }
  .ph-field { margin: 0 12px 14px; padding: 10px 12px; border: 1.5px solid var(--navy); border-radius: 12px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; background: #fff; }
  .ph-field b { font-size: 16px; }
  .doc { display: flex; gap: 10px; align-items: center; background: #19213f; border-radius: 9px; padding: 8px; margin-bottom: 6px; }
  .doc-ic { width: 34px; height: 40px; border-radius: 5px; background: var(--red); color: var(--navy); display: grid; place-items: end center; font: 800 9.5px var(--font-mono); padding-bottom: 4px; }
  .doc b { display: block; font: 600 12.5px var(--font-mono); }
  .doc small { font-size: 11.5px; opacity: .75; }
  .ph-call { background: var(--navy); color: var(--paper); align-items: center; justify-content: flex-start; padding: 40px 18px 22px; text-align: center; }
  .call-av { width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center; background: var(--red); color: var(--navy); font: 800 26px var(--font-display); position: relative; }
  .call-av::after { content: ""; position: absolute; inset: -10px; border-radius: 50%; border: 2px solid color-mix(in srgb, var(--red) 50%, transparent); }
  .call-name { margin-top: 18px; font: 700 20px var(--font-display); }
  .call-sub { color: var(--muted); font-size: 12.5px; }
  .call-state { margin: 10px 0 0; font: 500 14px var(--font-mono); color: var(--ok); position: relative; }
  .cs-ring { display: none; }
  .wave { display: flex; align-items: center; gap: 3px; height: 50px; margin: 26px 0 8px; }
  .wave i { width: 4px; border-radius: 2px; background: var(--red); height: calc(10px + (var(--i) * 7 % 34) * 1px); }
  .call-note { margin: 0; font: 13px/1.5 var(--font-mono); color: var(--muted); }
  .call-btns { margin-top: auto; display: flex; gap: 22px; }
  .cb { width: 48px; height: 48px; border-radius: 50%; background: var(--navy-3); }
  .cb-end { background: var(--red); }
  .ph-cap { margin: 0; font-size: 15px; color: var(--muted); }

  /* Replay (only when .play is set, so reduced motion shows settled frames) */
  .play .msg, .play .ph-field { animation: pop 420ms var(--d, 0ms) var(--ease-plug) both; }
  .play .msg-typing { display: flex; gap: 4px; align-self: flex-start; padding: 10px 12px; background: var(--navy); border-radius: 14px; overflow: hidden; max-height: 30px; animation: typing 650ms var(--d, 0ms) both; }
  .msg-typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--paper); opacity: .6; }
  @keyframes pop { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes typing { 0% { opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; max-height: 30px; } 100% { opacity: 0; max-height: 0; padding-top: 0; padding-bottom: 0; margin-bottom: -8px; } }
  .play .cs-ring { display: inline; animation: ringOut 1.4s steps(1) both; position: absolute; left: 50%; transform: translateX(-50%); color: var(--paper); white-space: nowrap; }
  .play .cs-on { animation: onIn 1.4s steps(1) both; }
  @keyframes ringOut { 0% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes onIn { 0% { opacity: 0; } 100% { opacity: 1; } }
  .play .call-av::after { animation: ring 700ms 2 var(--ease); }
  @keyframes ring { from { transform: scale(.9); opacity: 1; } to { transform: scale(1.25); opacity: 0; } }
  .play .wave i { animation: bar 900ms calc(1.4s + var(--i) * 40ms) ease-in-out infinite alternate; transform-origin: center; }
  @keyframes bar { from { transform: scaleY(.35); } to { transform: scaleY(1); } }

