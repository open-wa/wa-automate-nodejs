---
/**
 * The mark: a telephone-jack plug inside a speech bubble. On hover or keyboard
 * focus of the wrapping .mark-host link, the plug clicks up into the socket,
 * the contacts light and two signal arcs pulse out. Eases back on leave.
 */
interface Props { size?: number; label?: string }
const { size = 30, label = "open-wa" } = Astro.props;
---

<svg class="mark" viewBox="0 0 36 36" width={size} height={size} role="img" aria-label={label}>
  <path class="m-bubble" d="M9 4.5h18a5.5 5.5 0 0 1 5.5 5.5v10a5.5 5.5 0 0 1-5.5 5.5H15.5l-6.5 5.5v-5.5a5.5 5.5 0 0 1-5.5-5.5V10A5.5 5.5 0 0 1 9 4.5Z" />
  <path class="m-socket" d="M11.5 9.5h13" />
  <g class="m-plug">
    <rect class="m-body" x="12" y="13" width="12" height="8" rx="1.6" />
    <path class="m-pins" d="M14.6 13.4v2.4M16.9 13.4v2.4M19.1 13.4v2.4M21.4 13.4v2.4" />
    <path class="m-latch" d="M15.5 21h5v1.6h-5z" />
  </g>
  <g class="m-arcs">
    <path d="M30.2 2.4a4.6 4.6 0 0 1 2.6 2.6" />
    <path d="M30.6 -0.6a8 8 0 0 1 5.2 5.2" />
  </g>
</svg>

<style>
  .mark { overflow: visible; display: block; }
  .m-bubble { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linejoin: round; }
  .m-socket { stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; opacity: .55; transition: stroke 200ms, opacity 200ms; }
  .m-body { fill: var(--red); }
  .m-pins { stroke: var(--navy); stroke-width: 1.1; stroke-linecap: round; }
  .m-latch { fill: var(--red); opacity: .7; }
  .m-plug { transform: translateY(0); transition: transform 380ms var(--ease-plug); }
  .m-arcs path { fill: none; stroke: var(--red); stroke-width: 1.8; stroke-linecap: round; opacity: 0; }

  :global(.mark-host:hover) .m-plug,
  :global(.mark-host:focus-visible) .m-plug { transform: translateY(-3.1px); }
  :global(.mark-host:hover) .m-socket,
  :global(.mark-host:focus-visible) .m-socket { stroke: var(--red); opacity: 1; transition-delay: 220ms; }
  :global(.mark-host:hover) .m-arcs path,
  :global(.mark-host:focus-visible) .m-arcs path { animation: arc 1.1s 300ms var(--ease) infinite; }
  :global(.mark-host:hover) .m-arcs path + path,
  :global(.mark-host:focus-visible) .m-arcs path + path { animation-delay: 450ms; }
  @keyframes arc { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .m-plug { transition: none; }
    :global(.mark-host:hover) .m-arcs path,
    :global(.mark-host:focus-visible) .m-arcs path { animation: none; opacity: 1; }
  }
</style>
