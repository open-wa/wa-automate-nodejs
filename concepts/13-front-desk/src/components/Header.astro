---
import Mark from "./Mark.astro";
import { DOCS, support, stats, kDown } from "../data/facts";
const base = import.meta.env.BASE_URL.replace(/\/?$/u, "/");
const path = Astro.url.pathname;
const nav = [
  { href: `${base}recipes/`, label: "Recipes" },
  { href: `${base}features/`, label: "Features" },
  { href: `${base}integrations/`, label: "Integrations" },
  { href: `${base}pricing/`, label: "Pricing" },
];
const stars = kDown(stats.githubStars);
---

<header class="hd">
  <div class="hd-in wrap">
    <a class="hd-logo mark-host" href={base} aria-label="open-wa home">
      <Mark size={36} label="" />
      <span class="hd-name">open-wa</span>
    </a>
    <nav class="hd-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
      <a href={DOCS}>Docs <span class="ext" aria-hidden="true">↗</span></a>
    </nav>
    <div class="hd-right">
      <a class="hd-gh" href={support.github} aria-label={`GitHub, ${stars} stars as of ${stats.checkedOn}`}>
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>{stars}</span>
      </a>
      <a class="hd-discord" href={support.discord}>Discord</a>
      <a class="btn btn--ocean hd-cta" href={`${base}quickstart/`}>Quick start</a>
      <button class="hd-menu" type="button" aria-expanded="false" aria-controls="hd-sheet">
        <span class="hd-menu-icon" aria-hidden="true"><i></i><i></i></span>
        <span>Menu</span>
      </button>
    </div>
  </div>
  <div class="hd-sheet" id="hd-sheet" hidden>
    <nav class="wrap hd-sheet-in" aria-label="Menu">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href={`${base}quickstart/`}>Quick start</a>
      <a href={DOCS}>Docs <span aria-hidden="true">↗</span></a>
      <a href={support.github}>GitHub <span class="muted">{stars} stars</span></a>
      <a href={support.discord}>Discord</a>
      <a class="btn btn--primary" href={`${base}quickstart/`}>Get started</a>
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>(".hd-menu").forEach((btn) => {
    const sheet = document.getElementById(btn.getAttribute("aria-controls")!)!;
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      sheet.hidden = !open;
      document.documentElement.classList.toggle("menu-open", open);
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { set(false); btn.focus(); }
    });
    window.matchMedia("(min-width: 1100px)").addEventListener("change", (m) => { if (m.matches) set(false); });
  });
</script>

<style>
  .hd { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--sand) 92%, transparent); backdrop-filter: saturate(1.2) blur(10px); border-bottom: 1px solid var(--color-line); }
  .hd-in { display: flex; align-items: center; gap: 24px; height: var(--header-h); }
  .hd-logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; min-height: 44px; }
  .hd-name { font: 400 1.4rem/1 var(--font-display); letter-spacing: -0.01em; white-space: nowrap; }
  .hd-nav { display: flex; gap: 4px; margin-left: 12px; }
  .hd-nav a, .hd-discord, .hd-gh { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: 999px; text-decoration: none; font-weight: 500; }
  .hd-nav a:hover, .hd-discord:hover, .hd-gh:hover { background: var(--sand-100); }
  .hd-nav a[aria-current="page"] { background: var(--paper); box-shadow: inset 0 0 0 1px var(--color-line); }
  .ext { font-size: 0.85em; color: var(--color-muted); }
  .hd-right { margin-left: auto; display: flex; align-items: center; gap: 4px; }
  .hd-gh span { font-variant-numeric: tabular-nums; }
  .hd-cta { margin-left: 8px; min-height: 44px; }
  .hd-menu { display: none; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--ocean-300); background: transparent; color: var(--ocean); font: 600 1rem/1 var(--font-text); cursor: pointer; }
  .hd-menu-icon { display: grid; gap: 5px; width: 18px; }
  .hd-menu-icon i { display: block; height: 2px; background: currentColor; border-radius: 2px; transition: transform var(--speed) var(--ease); }
  .hd-menu[aria-expanded="true"] .hd-menu-icon i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .hd-menu[aria-expanded="true"] .hd-menu-icon i:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .hd-sheet { border-top: 1px solid var(--color-line); background: var(--sand); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; }
  .hd-sheet-in { display: grid; padding-block: 12px 24px; }
  .hd-sheet-in a:not(.btn) { display: flex; justify-content: space-between; align-items: center; min-height: 52px; border-bottom: 1px solid var(--color-line); text-decoration: none; font: 400 1.35rem/1.2 var(--font-display); }
  .hd-sheet-in .btn { margin-top: 18px; }
  @media (max-width: 1099px) {
    .hd-nav, .hd-discord, .hd-gh { display: none; }
    .hd-menu { display: inline-flex; }
  }
  @media (max-width: 520px) {
    .hd-in { gap: 12px; }
    .hd-cta { display: none; }
  }
</style>
