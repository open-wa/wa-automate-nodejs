---
import Mark from "./Mark.astro";
import { stats, support, short } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/?$/u, "/");
const path = Astro.url.pathname;
const nav = [
  { href: `${base}features/`, label: "Features" },
  { href: `${base}integrations/`, label: "Integrations" },
  { href: `${base}ai-agents/`, label: "AI agents" },
  { href: `${base}pricing/`, label: "Pricing" },
];
const more = [
  { href: `${base}quickstart/`, label: "Quick start" },
  { href: `${base}use-cases/`, label: "Use cases" },
  { href: `${base}compare/`, label: "Official API or open-wa?" },
  { href: `${base}migrate/`, label: "Migrate from v4" },
  { href: `${base}changelog/`, label: "Changelog" },
  { href: `${base}community/`, label: "Community" },
  { href: `${base}support/`, label: "Support and consulting" },
];
const isOn = (href: string) => path.startsWith(href) && href !== base;
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="mark-host brand" href={base} aria-label="open-wa home">
      <Mark size={28} label="" />
      <span class="brand-name">open-wa</span>
    </a>
    <nav class="hdr-nav" aria-label="Main">
      <a href={support.docs} class="nav-link">Docs</a>
      {nav.map((n) => <a href={n.href} class="nav-link" aria-current={isOn(n.href) ? "page" : undefined}>{n.label}</a>)}
    </nav>
    <div class="hdr-end">
      <a class="gh" href={support.github} title={`GitHub stars on ${stats.checkedOn}`}>
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="gh-label">GitHub</span><span class="gh-stars">{short(stats.githubStars)}</span>
      </a>
      <a class="nav-link hdr-discord" href={support.discord}>Discord</a>
      <a class="btn btn-ink hdr-cta" href={`${base}quickstart/`}>Quick start</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-sheet" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="sheet" id="menu-sheet" hidden>
    <nav class="wrap sheet-in" aria-label="Menu">
      <a href={support.docs}>Docs</a>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      {more.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href={support.github}>GitHub <span class="muted mono small">{short(stats.githubStars)} stars, {stats.checkedOn}</span></a>
      <a href={support.discord}>Discord</a>
      <a class="btn btn-ink sheet-cta" href={`${base}quickstart/`}>Quick start</a>
    </nav>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--grey-2); }
  .hdr-in { display: flex; align-items: center; gap: 24px; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; min-height: 44px; font-weight: 700; font-size: 19px; letter-spacing: -0.02em; }
  .hdr-nav { display: flex; gap: 4px; flex: 1; }
  .nav-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px; text-decoration: none; color: var(--grey-5); font-size: 16px; font-weight: 500; }
  .nav-link:hover, .nav-link[aria-current="page"] { color: var(--ink); background: var(--grey-1); }
  .hdr-end { display: flex; align-items: center; gap: 6px; }
  .gh { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; border-radius: 999px; text-decoration: none; color: var(--grey-5); font-size: 16px; font-weight: 500; }
  .gh:hover { color: var(--ink); background: var(--grey-1); }
  .gh-stars { font: 14px/1 var(--font-mono); padding: 5px 7px; border-radius: 6px; background: var(--grey-1); color: var(--ink); }
  .menu-btn { display: none; width: 44px; height: 44px; border: 1px solid var(--grey-2); border-radius: 999px; background: var(--white); cursor: pointer; position: relative; }
  .menu-btn span { position: absolute; left: 13px; right: 13px; height: 2px; background: var(--ink); transition: transform var(--speed) var(--ease); }
  .menu-btn span:first-child { top: 17px; } .menu-btn span:last-child { top: 24px; }
  .menu-btn[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .sheet { border-top: 1px solid var(--grey-2); background: var(--paper); max-height: calc(100dvh - 64px); overflow-y: auto; }
  .sheet-in { display: grid; padding-top: 8px; padding-bottom: 24px; }
  .sheet-in a:not(.btn) { display: flex; align-items: center; gap: 10px; justify-content: space-between; min-height: 52px; border-bottom: 1px solid var(--grey-2); text-decoration: none; font-size: 19px; font-weight: 550; }
  .sheet-cta { margin-top: 20px; min-height: 52px; }
  @media (max-width: 1080px) { .hdr-discord { display: none; } .gh-label { display: none; } }
  @media (max-width: 900px) {
    .hdr-nav { display: none; }
    .hdr-end { margin-left: auto; }
    .menu-btn { display: block; }
  }
  @media (max-width: 480px) { .hdr-cta { display: none; } .gh { padding: 0 8px; } }
  @media (min-width: 901px) { .sheet { display: none !important; } }
</style>
