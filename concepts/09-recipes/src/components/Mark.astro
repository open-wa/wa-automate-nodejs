---
/**
 * The mark: a recipe card with a folded corner. On hover or keyboard focus of
 * the link around it (.mark-host), the dog-ear unfolds, the card grows a tail
 * and its three recipe lines gather into dots: the recipe becomes a message.
 * Reduced motion: it stays a card. The favicon is the still card.
 */
interface Props { size?: number; label?: string }
const { size = 30, label = "open-wa" } = Astro.props;
---

<svg class="mark" viewBox="0 0 32 32" width={size} height={size} role="img" aria-label={label}>
  <path class="mark-body" d="M6 5 L21 5 L28 12 L28 24 Q28 26 26 26 L12 26 L8 26 L8 26 L6 26 Q4 26 4 24 L4 7 Q4 5 6 5 Z" />
  <path class="mark-line l1" d="M8.5 11 L16 11" />
  <path class="mark-line l2" d="M8.5 15.5 L23.5 15.5" />
  <path class="mark-line l3" d="M8.5 20 L19 20" />
  <path class="mark-flap" d="M21 5 L21 12 L28 12 Z" />
</svg>

<style>
  .mark { display: block; overflow: visible; flex: none; }
  .mark-body {
    fill: var(--ink);
    transition: d 520ms var(--ease-out);
  }
  .mark-line {
    fill: none; stroke: var(--paper); stroke-width: 2.4; stroke-linecap: round;
    transition: d 460ms var(--ease-out), stroke 300ms var(--ease);
  }
  .mark-line.l2 { transition-delay: 40ms; }
  .mark-line.l3 { transition-delay: 80ms; }
  .mark-flap {
    fill: var(--tomato);
    transform-box: view-box;
    transform-origin: 24.5px 8.5px;
    transition: transform 520ms var(--ease-out), fill 260ms var(--ease) 180ms;
  }
  :global(.mark-host:hover) .mark-body,
  :global(.mark-host:focus-visible) .mark-body {
    d: path("M6 5 L26 5 L28 7 L28 24 Q28 26 26 26 L12 26 L6.5 30.5 L8 26 L6 26 Q4 26 4 24 L4 7 Q4 5 6 5 Z");
  }
  :global(.mark-host:hover) .mark-flap,
  :global(.mark-host:focus-visible) .mark-flap {
    transform: rotate3d(1, 1, 0, 180deg);
    fill: var(--ink);
  }
  :global(.mark-host:hover) .l1, :global(.mark-host:focus-visible) .l1 { d: path("M11 15.5 L11 15.5"); stroke: var(--tomato); }
  :global(.mark-host:hover) .l2, :global(.mark-host:focus-visible) .l2 { d: path("M16 15.5 L16 15.5"); stroke: var(--saffron); }
  :global(.mark-host:hover) .l3, :global(.mark-host:focus-visible) .l3 { d: path("M21 15.5 L21 15.5"); stroke: var(--sky); }
  @media (prefers-reduced-motion: reduce) {
    .mark-body, .mark-line, .mark-flap { transition: none; }
  }
</style>
