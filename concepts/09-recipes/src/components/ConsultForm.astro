---
/** "Tell us what you need": the consulting lead, through submitLead("consulting"). */
import { support } from "../data/site";
---

<div class="cf">
  <form class="cf-form" novalidate data-cf>
    <div class="cf-field">
      <label for="cf-name">Your name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" aria-describedby="cf-name-err" />
      <p class="cf-err" id="cf-name-err" aria-live="polite"></p>
    </div>
    <div class="cf-field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" aria-describedby="cf-email-err" />
      <p class="cf-err" id="cf-email-err" aria-live="polite"></p>
    </div>
    <div class="cf-field">
      <label for="cf-need">What do you need?</label>
      <textarea id="cf-need" name="need" rows="4" placeholder="e.g. Set up booking reminders for our three salons" aria-describedby="cf-need-err"></textarea>
      <p class="cf-err" id="cf-need-err" aria-live="polite"></p>
    </div>
    <button class="btn btn-ink" type="submit">Send</button>
    <p class="cf-small">Or email <a href={`mailto:${support.consultingEmail}`}>{support.consultingEmail}</a>.</p>
  </form>
  <div class="cf-done" hidden tabindex="-1" data-cf-done>
    <h3>Thanks, we have your message</h3>
    <p>Mohammed replies by email, usually with a few questions about your number, your stack and the job. Demo: nothing was sent from this concept.</p>
  </div>
</div>

<script>
  import { submitLead } from "../lib/leads";
  const form = document.querySelector<HTMLFormElement>("[data-cf]");
  const done = document.querySelector<HTMLElement>("[data-cf-done]");
  if (form && done) {
    const rules: Record<string, (v: string) => string> = {
      name: (v) => v.trim() ? "" : "Enter your name.",
      email: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? "" : "Enter an email address we can reply to.",
      need: (v) => v.trim().length >= 6 ? "" : "Tell us in a few words what you need.",
    };
    const check = (n: string) => {
      const el = form.elements.namedItem(n) as HTMLInputElement;
      const msg = rules[n]!(el.value);
      document.getElementById(`${el.id}-err`)!.textContent = msg;
      el.setAttribute("aria-invalid", String(!!msg));
      return !msg;
    };
    Object.keys(rules).forEach((n) => {
      const el = form.elements.namedItem(n) as HTMLInputElement;
      el.addEventListener("input", () => { if (el.getAttribute("aria-invalid") === "true" || !rules[n]!(el.value)) check(n); });
    });
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const bad = Object.keys(rules).filter((n) => !check(n));
      if (bad.length) { (form.elements.namedItem(bad[0]!) as HTMLElement).focus(); return; }
      const d = new FormData(form);
      await submitLead("consulting", { name: String(d.get("name")), email: String(d.get("email")), need: String(d.get("need")) });
      form.hidden = true; done.hidden = false; done.focus();
    });
  }
</script>

<style>
  .cf { background: var(--card); border-radius: 22px; padding: clamp(18px, 3vw, 30px); box-shadow: inset 0 0 0 1px var(--line); max-width: 620px; }
  .cf-form { display: grid; gap: 16px; }
  .cf-field label { display: block; font-weight: 600; margin-bottom: 8px; }
  .cf-field input, .cf-field textarea { width: 100%; min-height: 48px; padding: 12px 14px; border-radius: 12px; border: 0; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-2); font: 400 1rem/1.4 var(--font-text); color: var(--ink); }
  .cf-field input:focus, .cf-field textarea:focus { outline: none; box-shadow: inset 0 0 0 2px var(--ink); background: var(--card); }
  .cf-field [aria-invalid="true"] { box-shadow: inset 0 0 0 2px var(--tomato-ink); }
  .cf-err { margin: 6px 0 0; color: var(--tomato-ink); font-size: 0.9375rem; font-weight: 500; }
  .cf-err:empty { display: none; }
  .cf-form .btn { justify-self: start; }
  .cf-small { margin: 0; color: var(--ink-2); font-size: 0.9375rem; }
  .cf-done h3 { font: 400 2rem/1.1 var(--font-display); margin: 0 0 8px; }
  .cf-done:focus { outline: none; }
</style>
