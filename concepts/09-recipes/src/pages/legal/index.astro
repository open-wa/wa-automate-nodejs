---
import Page from "../../layouts/Page.astro";
import { legal, product, support } from "../../data/site";
---

<Page title="Legal: unofficial notice, terms and licence | open-wa" description="open-wa is unofficial and not affiliated with WhatsApp or Meta. Terms of Service, software licence and export notice.">
  <div class="wrap page-head">
    <h1 class="h-display">Legal</h1>
  </div>
  <div class="wrap doc">
    <h2>Unofficial notice</h2>
    <p>{legal.affiliation}</p>
    <h2>Account risk</h2>
    <p>{product.risk}</p>
    <h2>Terms of Service</h2>
    <p>{product.terms} <a href={support.terms}>Read the Terms of Service</a>.</p>
    <h2>Software licence</h2>
    <p>{product.softwareLicence}. <a href={support.licenceText}>Read the licence</a>.</p>
    <h2>Cryptography</h2>
    <p>{legal.crypto}</p>
    <p>{legal.copyright}.</p>
  </div>
</Page>
