---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/figtree';
import '../styles/site.css';
import Mark from '../components/Mark.astro';
import { triggers, actions, getCombo, highlight, destIcons, renderCode } from '../lib/combos';

const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}wally/${name}.webp`;
const initial = getCombo('message', 'send');

const LINKS = {
  quickstart: 'https://openwa.dev/docs/getting-started/quickstart',
  docs: 'https://openwa.dev/docs',
  reference: 'https://openwa.dev/docs/reference/client/client',
  github: 'https://github.com/open-wa/wa-automate-nodejs',
  discord: 'https://discord.gg/dpan7EYE3t',
  licensing: 'https://openwa.dev/docs/licensing/licensed-features',
};



const ways = [
  {
    id: 'easy',
    name: 'Easy API',
    kicker: 'CLI',
    color: 'sun',
    img: 'easy-api',
    line: 'One command gives you a local HTTP API with live docs at /api-docs/.',
    file: 'terminal',
    lang: 'bash' as const,
    code: 'npx @open-wa/wa-automate@latest --port 8080 --api-key "your-secure-key"',
    extra: 'OpenAPI at /meta/swagger.json, Postman at /meta/postman.json.',
  },
  {
    id: 'socket',
    name: 'SocketClient',
    kicker: 'Node.js',
    color: 'sky',
    img: 'socket',
    line: 'Drive a running Easy API from another Node.js app. HTTP RPC for commands, Server-Sent Events for events.',
    file: 'bot.ts',
    lang: 'ts' as const,
    code: `import { SocketClient } from '@open-wa/socket-client';

const client = await SocketClient.connect('http://localhost:8080', 'your-secure-key');
client.onMessage(async (message) => {
  if (message.body === 'Hi') await client.sendText(message.from, 'Hello!');
});`,
    extra: '',
  },
  {
    id: 'embedded',
    name: 'Embedded runtime',
    kicker: 'In your app',
    color: 'gum',
    img: 'embedded',
    line: 'Run createClient inside your own Node.js app and pick a browser driver: Puppeteer, Playwright or Lightpanda.',
    file: 'app.ts',
    lang: 'ts' as const,
    code: `import { createClient } from '@open-wa/wa-automate';
import { PuppeteerDriver } from '@open-wa/driver-puppeteer';

const client = await createClient({ sessionId: 'sales', driver: new PuppeteerDriver(), headless: true });`,
    extra: '',
  },
  {
    id: 'mcp',
    name: 'MCP',
    kicker: 'AI agents',
    color: 'lilac',
    img: 'mcp',
    line: 'A built-in Model Context Protocol server at /mcp. Every Easy API method becomes a tool for Claude, Cursor or Windsurf.',
    file: 'wa.config.mjs',
    lang: 'js' as const,
    code: `// wa.config.mjs: MCP
export default { apiKey: process.env.WA_API_KEY, port: 8080, mcp: { enabled: true, path: '/mcp' } };`,
    extra: '',
  },
];

const integrations = [
  { name: 'Webhook', img: 'webhook-plug', line: 'POST events as JSON to any endpoint you own.', color: 'cobalt', tilt: -3 },
  { name: 'Chatwoot', img: 'chatwoot', line: 'Answer WhatsApp chats from a shared support inbox.', color: 'lilac', tilt: 2 },
  { name: 'S3', img: 's3', line: 'Connect S3 and cloud storage to your sessions.', color: 'tangerine', tilt: -1.5 },
  { name: 'Cloudflare session proxy', img: 'cloudflare', line: 'Reach a local session remotely without opening public ports.', color: 'sun', tilt: 2.5 },
  { name: 'Node-RED', img: 'node-red', line: 'Wire WhatsApp into Node-RED flows.', color: 'tomato', tilt: -2 },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>open-wa · build a WhatsApp bot in the playground</title>
    <meta name="description" content="open-wa turns a WhatsApp account into an API, bot runtime, webhook bridge and AI tool surface on your own infrastructure. Pick a trigger, pick an action, see the real code." />
    <meta name="theme-color" content="#FFF7EC" />
    <link rel="preload" as="image" href={img('hero')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#playground">Skip to the playground</a>

    <header class="top">
      <a class="brand mark-host" href={base} aria-label="open-wa home">
        <Mark size={42} />
        <span class="wordmark">open-wa</span>
      </a>
      <nav class="topnav" aria-label="Main">
        <a href={LINKS.docs}>Docs</a>
        <a href={LINKS.reference}>API reference</a>
        <a href={LINKS.github} class="gh">GitHub <span class="pill">3.6k ★</span></a>
        <a href={LINKS.discord}>Discord</a>
      </nav>
      <a class="btn btn-ink toy" href={LINKS.quickstart}>Send your first message</a>
    </header>

    <main>
      <!-- ============ HERO + PLAYGROUND ============ -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-head">
          <div class="hero-copy">
            <p class="chips">
              <span class="chip chip-sun">v5.0.0</span>
              <span class="chip chip-gum">open source since 2019</span>
              <span class="chip chip-sky">runs on your own server</span>
            </p>
            <h1 id="hero-title">
              Pick a trigger.<br /> Pick an action.<br />
              <span class="h1-pop">Ship a WhatsApp bot.</span>
            </h1>
            <p class="lede">
              open-wa turns a WhatsApp account into an API, bot runtime, webhook bridge and AI tool
              surface on your own machine or server. <span class="lede-more">Play with it below: every combo shows the real code.</span>
            </p>
          </div>
          <div class="hero-wally" aria-hidden="true">
            <img src={img('hero')} width="280" height="280" alt="" decoding="async" fetchpriority="high" />
            <span class="hero-say">Try a combo!</span>
          </div>
        </div>

        <div class="board" id="playground" data-step="1" tabindex="-1">
          <h2 class="sr-only">Bot playground</h2>
          <ol class="stepper" aria-label="Playground steps">
            <li><button type="button" class="step-btn" data-goto="1" aria-current="step"><span>1</span>When</button></li>
            <li><button type="button" class="step-btn" data-goto="2"><span>2</span>Then</button></li>
            <li><button type="button" class="step-btn" data-goto="3"><span>3</span>Watch</button></li>
          </ol>

          <div class="panel panel-when" data-panel="1">
            <h3 class="panel-title" id="when-label"><span class="badge badge-warm">1</span> When…</h3>
            <div class="choices" role="radiogroup" aria-labelledby="when-label" data-group="trigger">
              {triggers.map((t, i) => (
                <button
                  type="button"
                  class="choice toy"
                  role="radio"
                  aria-checked={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-value={t.id}
                  style={`--c:${t.color}`}
                >
                  <span class="choice-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26"><path d={t.icon} /></svg>
                  </span>
                  <span class="choice-text">
                    <span class="choice-label">{t.label}</span>
                    <span class="choice-hint">{t.hint}</span>
                  </span>
                  <span class="choice-tick" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                  </span>
                </button>
              ))}
            </div>
          </div>

          <div class="panel panel-then" data-panel="2">
            <h3 class="panel-title" id="then-label"><span class="badge badge-cool">2</span> Then…</h3>
            <div class="choices" role="radiogroup" aria-labelledby="then-label" data-group="action">
              {actions.map((a, i) => (
                <button
                  type="button"
                  class="choice toy"
                  role="radio"
                  aria-checked={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-value={a.id}
                  style={`--c:${a.color}`}
                >
                  <span class="choice-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26"><path d={a.icon} /></svg>
                  </span>
                  <span class="choice-text">
                    <span class="choice-label">{a.label}</span>
                    <span class="choice-hint">{a.hint}</span>
                  </span>
                  <span class="choice-tick" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                  </span>
                </button>
              ))}
            </div>
          </div>

          <div class="stage" data-panel="3">
            <div class="stage-top">
              <h3 class="panel-title"><span class="badge badge-ink">3</span> Watch it run</h3>
              <button type="button" class="btn btn-small toy replay" data-replay>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5" /></svg>
                Replay
              </button>
            </div>

            <div class="flow" aria-hidden="true">
              <div class="node" data-node="0" style={`--c:${triggers[0].color}`}>
                <span class="node-icon"><svg viewBox="0 0 24 24" width="22" height="22"><path d={triggers[0].icon} /></svg></span>
                <span class="node-label">{initial.nodes[0]}</span>
              </div>
              <div class="wire"><span class="wire-dot"></span></div>
              <div class="node node-hub" data-node="1" style="--c:var(--sun)">
                <span class="node-icon"><Mark size={30} /></span>
                <span class="node-label">open-wa</span>
              </div>
              <div class="wire"><span class="wire-dot"></span></div>
              <div class="node" data-node="2" style={`--c:${actions[0].color}`}>
                <span class="node-icon"><svg viewBox="0 0 24 24" width="22" height="22"><path d={actions[0].icon} /></svg></span>
                <span class="node-label">{initial.nodes[2]}</span>
              </div>
              <div class="wire"><span class="wire-dot"></span></div>
              <div class="node node-dest" data-node="3" style="--c:var(--card)">
                <span class="node-icon"><svg viewBox="0 0 24 24" width="22" height="22"><path d={destIcons.send} /></svg></span>
                <span class="node-label">{initial.nodes[3]}</span>
              </div>
            </div>

            <ol class="caption" aria-live="polite">
              {initial.caption.map((c, i) => <li data-cap={i} data-n={i + 1} class="is-on">{c}</li>)}
            </ol>

            <div class="stage-body">
              <div class="phone" role="img" aria-label="Phone preview of the conversation">
                <div class="phone-screen">
                  <div class="phone-bar">
                    <span class="phone-avatar"><Mark size={26} /></span>
                    <span class="phone-who"><b>[Your business]</b><small>+44 7700 900000</small></span>
                  </div>
                  <div class="chat">
                    <div class="chat-day">Today</div>
                    <div class="bubble from-customer"><p>{initial.first.text}</p><span class="meta">09:41</span></div>
                    {initial.result && <div class="bubble from-business"><p>{initial.result.text}</p><span class="meta">09:41</span></div>}
                  </div>
                  <div class="phone-input"><span>Message</span></div>
                </div>
              </div>

              <div class="side">
                <div class="inspector" data-kind="send">
                  <img class="inspector-wally" src={img('send')} width="120" height="120" alt="" loading="lazy" />
                  <p class="inspector-kicker">Easy API call</p>
                  <p class="inspector-title">{initial.inspector.title}</p>
                  <pre class="inspector-body">{initial.inspector.body}</pre>
                </div>

                <div class="code">
                  <div class="code-blocks" set:html={renderCode(initial.code)} />
                  <div class="code-foot">
                    <p class="code-note">{initial.note}</p>
                    <button type="button" class="btn btn-small btn-sun toy" data-copy-combo>Copy code</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="stepnav">
            <button type="button" class="btn btn-ghost toy" data-prev>Back</button>
            <button type="button" class="btn btn-ink toy" data-next>Next</button>
          </div>
        </div>
      </section>

      <!-- ============ FOUR WAYS IN ============ -->
      <section class="section ways" aria-labelledby="ways-title">
        <div class="section-head">
          <p class="eyebrow">Four ways in</p>
          <h2 id="ways-title">Start wherever your code already lives.</h2>
          <p class="section-lede">Every card flips over to show how it starts. Same WhatsApp account, four doors.<span class="swipe-hint"> Swipe for more.</span></p>
        </div>
        <div class="ways-grid">
          {ways.map((w, i) => (
            <article class={`way way-${w.color}`} style={`--tilt:${[-2, 1.5, -1, 2][i]}deg`}>
              <div class="way-inner">
                <div class="way-face way-front">
                  <p class="way-kicker">{w.kicker}</p>
                  <h3>{w.name}</h3>
                  <p class="way-line">{w.line}</p>
                  <img src={img(w.img)} width="200" height="200" alt="" loading="lazy" decoding="async" />
                </div>
                <div class="way-face way-back" inert>
                  <p class="way-kicker">{w.file}</p>
                  <pre><code set:html={highlight(w.code, w.lang)} /></pre>
                  {w.extra && <p class="way-extra">{w.extra}</p>}
                </div>
              </div>
              <button type="button" class="way-flip toy" aria-pressed="false" aria-label={`Show the code for ${w.name}`}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 4v4h-4M20 12a8 8 0 0 1-14 5.3M4 20v-4h4" /></svg>
                <span class="way-flip-label">Flip for code</span>
              </button>
            </article>
          ))}
        </div>
      </section>

      <!-- ============ INTEGRATIONS ============ -->
      <section class="section integ" aria-labelledby="integ-title">
        <div class="section-head">
          <p class="eyebrow">Integrations</p>
          <h2 id="integ-title">Snap it onto the rest of your stack.</h2>
          <p class="section-lede">
            Five integrations load as plugins from <code>wa.config.*</code>. Need something else? Write your own with
            <code>@open-wa/plugin-sdk</code>.
          </p>
        </div>
        <ul class="stickers">
          {integrations.map((s) => (
            <li class={`sticker sticker-${s.color}`} style={`--tilt:${s.tilt}deg`}>
              <img src={img(s.img)} width="120" height="120" alt="" loading="lazy" decoding="async" />
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))}
          <li class="sticker sticker-diy" style="--tilt:1deg">
            <span class="diy-plus" aria-hidden="true">+</span>
            <h3>Your own plugin</h3>
            <p>Use <code>plugins</code> and <code>pluginConfig</code>, built with <code>@open-wa/plugin-sdk</code>.</p>
          </li>
        </ul>
        <div class="drivers">
          <p>Three browser drivers, swap them freely:</p>
          <ul>
            <li>Puppeteer</li>
            <li>Playwright</li>
            <li>Lightpanda</li>
          </ul>
        </div>
      </section>

      <!-- ============ NUMBERS ============ -->
      <section class="section numbers" aria-labelledby="num-title">
        <div class="section-head">
          <p class="eyebrow">The honest numbers</p>
          <h2 id="num-title">Seven years of open source, still shipping.</h2>
        </div>
        <ul class="num-grid">
          <li class="num num-sun"><b data-count="3.6" data-decimals="1" data-suffix="k">3.6k</b><span>GitHub stars</span></li>
          <li class="num num-sky"><b data-count="723">723</b><span>forks</span></li>
          <li class="num num-gum"><b>2019</b><span>open source since August</span></li>
          <li class="num num-tomato"><b>v5.0.0</b><span>current stable line</span></li>
          <li class="num num-lilac"><b>/mcp</b><span>built-in MCP server</span></li>
          <li class="num num-wally">
            <img src={img('bell')} width="150" height="150" alt="" loading="lazy" decoding="async" />
            <span>Counts as of 8 October 2026.</span>
          </li>
        </ul>
      </section>

      <!-- ============ GET STARTED ============ -->
      <section class="section start" aria-labelledby="start-title">
        <div class="section-head">
          <p class="eyebrow">Getting started</p>
          <h2 id="start-title">Three steps to your first message.</h2>
          <p class="section-lede">You need Node.js 22.21.1 or newer, and a phone with WhatsApp.</p>
        </div>
        <ol class="steps">
          <li class="stepcard stepcard-sun">
            <span class="step-num" aria-hidden="true">1</span>
            <img src={img('cli')} width="150" height="150" alt="" loading="lazy" decoding="async" />
            <h3>Start the Easy API</h3>
            <p>One command starts a local HTTP API on port 8080, with live docs at <code>/api-docs/</code>.</p>
            <div class="snip">
              <pre><code set:html={highlight('npx @open-wa/wa-automate@latest --port 8080', 'bash')} /></pre>
              <button type="button" class="copy toy" data-copy="npx @open-wa/wa-automate@latest --port 8080">Copy</button>
            </div>
            <p class="step-alt">Prefer Docker? <code>docker run -p 8080:8080 --init openwa/wa-automate</code></p>
          </li>
          <li class="stepcard stepcard-gum">
            <span class="step-num" aria-hidden="true">2</span>
            <img src={img('link')} width="150" height="150" alt="" loading="lazy" decoding="async" />
            <h3>Link your phone</h3>
            <p>Scan the QR code or enter a link code. You do it once per named session, so <code>sales</code> and <code>support</code> can each have their own.</p>
            <div class="snip">
              <pre><code set:html={highlight('npx @open-wa/wa-automate@latest --session-id sales --port 8081', 'bash')} /></pre>
              <button type="button" class="copy toy" data-copy="npx @open-wa/wa-automate@latest --session-id sales --port 8081">Copy</button>
            </div>
          </li>
          <li class="stepcard stepcard-sky">
            <span class="step-num" aria-hidden="true">3</span>
            <img src={img('send')} width="150" height="150" alt="" loading="lazy" decoding="async" />
            <h3>Send your first message</h3>
            <div class="snip">
              <pre><code set:html={highlight(`curl -X POST http://localhost:8080/api/messages/sendText \\
  -H "Content-Type: application/json" \\
  -d '{"to": "447700900123@c.us", "content": "Your order is ready to collect!"}'`, 'bash')} /></pre>
              <button type="button" class="copy toy" data-copy={`curl -X POST http://localhost:8080/api/messages/sendText \\\n  -H "Content-Type: application/json" \\\n  -d '{"to": "447700900123@c.us", "content": "Your order is ready to collect!"}'`}>Copy</button>
            </div>
          </li>
        </ol>
        <div class="cta">
          <a class="btn btn-big btn-tomato toy" href={LINKS.quickstart}>Send your first message</a>
          <a class="btn btn-big btn-ghost toy" href={LINKS.docs}>Read the docs</a>
        </div>
        <p class="license-note">
          Some methods need a Restricted or Insiders license. <a href={LINKS.licensing}>See licensed features</a>.
        </p>
      </section>
    </main>

    <footer class="foot">
      <div class="foot-row">
        <a class="brand mark-host" href={base} aria-label="open-wa home">
          <Mark size={36} />
          <span class="wordmark">open-wa</span>
        </a>
        <nav aria-label="Footer">
          <a href={LINKS.docs}>Docs</a>
          <a href={LINKS.reference}>Client API reference</a>
          <a href={LINKS.github}>GitHub</a>
          <a href={LINKS.discord}>Discord</a>
          <a href={LINKS.licensing}>Licensed features</a>
        </nav>
      </div>
      <p class="disclaimer">open-wa is unofficial and not affiliated with WhatsApp or Meta.</p>
      <p class="fine">Example numbers on this page are fictional. Automating a WhatsApp account carries risk; read the docs before you ship.</p>
    </footer>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
