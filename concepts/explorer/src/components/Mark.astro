---
// The open-wa "Playground" mark: a speech bubble that is also Wally's face.
// Round spectacles, a cream muzzle and two tusks live inside the bubble.
// Hover or focus on the parent .mark-host makes it wiggle and blink.
interface Props { size?: number; class?: string }
const { size = 40, class: cls = '' } = Astro.props;
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <g class="mark-bubble">
    <path class="mark-shadow" d="M24 6c12 0 20 7 20 17s-8 17-20 17c-2.5 0-5-.4-7.2-1.1L8 44l2.4-8.4C6.4 32.6 4 28.1 4 23 4 13 12 6 24 6z" fill="#22172E" transform="translate(1.6 2)"/>
    <path d="M24 6c12 0 20 7 20 17s-8 17-20 17c-2.5 0-5-.4-7.2-1.1L8 44l2.4-8.4C6.4 32.6 4 28.1 4 23 4 13 12 6 24 6z" fill="#FFC233" stroke="#22172E" stroke-width="2.4" stroke-linejoin="round"/>
    <g class="mark-face">
      <path d="M21.6 20.2h4.8" stroke="#22172E" stroke-width="2" stroke-linecap="round"/>
      <circle cx="16.8" cy="20.4" r="5" fill="#fff" stroke="#22172E" stroke-width="2.2"/>
      <circle cx="31.2" cy="20.4" r="5" fill="#fff" stroke="#22172E" stroke-width="2.2"/>
      <g class="mark-eyes">
        <circle cx="17.4" cy="21" r="1.9" fill="#22172E"/>
        <circle cx="30.6" cy="21" r="1.9" fill="#22172E"/>
      </g>
      <path class="mark-tusk" d="M20.6 30.6l1.3 6.2 1.5-5.8z" fill="#fff" stroke="#22172E" stroke-width="1.5" stroke-linejoin="round"/>
      <path class="mark-tusk" d="M27.4 30.6l-1.3 6.2-1.5-5.8z" fill="#fff" stroke="#22172E" stroke-width="1.5" stroke-linejoin="round"/>
      <ellipse cx="20.9" cy="28.6" rx="4.1" ry="3.2" fill="#FFE3BD" stroke="#22172E" stroke-width="1.6"/>
      <ellipse cx="27.1" cy="28.6" rx="4.1" ry="3.2" fill="#FFE3BD" stroke="#22172E" stroke-width="1.6"/>
      <ellipse cx="24" cy="26.1" rx="2.1" ry="1.4" fill="#22172E"/>
    </g>
  </g>
</svg>
