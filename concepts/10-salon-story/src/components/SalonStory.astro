---
// Signature moment: five scroll scenes at Rosa's (an example salon). On a
// pinned stage, the phone's message and the code line that sent it move
// together as you scroll. Without JS, with reduced motion or ?still, every
// scene renders static with its phone and code side by side.
import "../styles/phone.css";
import Phone from "./Phone.astro";
import CodeBlock from "./CodeBlock.astro";
import { scenes, messages, staffNote, salonSnippet, reminderCurl, lateSnippet } from "../data/story";

const panels = [
  { id: "salon", code: salonSnippet, lang: "js", title: "bookings.js" },
  { id: "curl", code: reminderCurl, lang: "bash", title: "Thursday 18:00, from a cron job in any language" },
  { id: "late", code: lateSnippet, lang: "js", title: "late.js" },
];
const panelCode = (p: string) => panels.find((x) => x.id === p)!;
const dayIndex = (when: string) => (when.startsWith("Tuesday") ? 0 : when.startsWith("Thursday") ? 2 : 3);
const clientScenes = scenes.map((s) => ({
  title: s.title, when: s.when, key: s.key, panel: s.panel, hl: s.hl, clock: s.clock, day: dayIndex(s.when),
}));
const sceneMsgs = (i: number) => messages.filter((m) => m.at >= i && m.at < i + 1);
const uniq = (a: number[]) => [...new Set(a)];
---
<section class="story" id="story" aria-labelledby="story-h" data-scenes={JSON.stringify(clientScenes)}>
  <script is:inline>
    (function () {
      var s = document.currentScript && document.currentScript.parentElement;
      var still = /[?&]still\b/.test(location.search) || matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (s && !still) s.classList.add("story--live");
    })();
  </script>
  <div class="wrap story-head">
    <span class="label-ex">Example</span>
    <h2 id="story-h">One booking at Rosa's, <em>start to finish</em></h2>
    <p>Rosa's is an example salon with one WhatsApp number and a few chairs. Scroll through a week of one customer's booking and watch each message leave your code.</p>
  </div>

  <div class="story-body wrap">
    <div class="stage">
      <div class="stage-cap" aria-hidden="true">
        <p class="stage-num"><span class="stage-i">1</span> of 5 · <span class="stage-when">{scenes[0].when}</span></p>
        <p class="stage-title">{scenes[0].title}</p>
        <p class="stage-key">{scenes[0].key}</p>
      </div>
      <div class="stage-phone">
        <Phone msgs={messages} live />
        <div class="staff" aria-hidden="true">
          <span class="staff-ic"><svg viewBox="0 0 20 20" width="16" height="16"><path d="M10 3v7l4 2" fill="none" stroke="#2b1b17" stroke-width="2" stroke-linecap="round"/></svg></span>
          <div><strong>{staffNote.who}</strong><p>{staffNote.text}</p></div>
        </div>
      </div>
      <div class="stage-side">
        <div class="stage-clock" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="40" height="40">
            <circle cx="20" cy="20" r="17" fill="var(--blush)" stroke="var(--espresso)" stroke-width="2" />
            <line class="clk-h" x1="20" y1="20" x2="20" y2="11.5" />
            <line class="clk-m" x1="20" y1="20" x2="20" y2="7" />
            <circle cx="20" cy="20" r="2" fill="var(--espresso)" />
          </svg>
          <span class="stage-when">{scenes[0].when}</span>
        </div>
        <div class="stage-code">
          {panels.map((p, i) => (
            <div class:list={["stage-panel", { "is-on": i === 0 }]} data-panel={p.id} inert={i === 0 ? undefined : true}>
              <CodeBlock code={p.code} lang={p.lang} title={p.title} />
            </div>
          ))}
        </div>
        <ol class="stage-dots" aria-label="Scenes">
          {scenes.map((s, i) => (
            <li><button type="button" data-go={i} aria-label={`Scene ${i + 1}: ${s.title}`} aria-current={i === 0 ? "step" : undefined}></button></li>
          ))}
        </ol>
      </div>
    </div>

    <ol class="steps">
      {scenes.map((s, i) => (
        <li class="step" id={`scene-${s.id}`} data-i={i}>
          <div class="step-text">
            <p class="step-num">{i + 1} of 5 · {s.when}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <p class="step-meta"><span>{s.methods.map((m) => <code>{m}</code>)}</span></p>
            <p class="step-key">{s.key}</p>
          </div>
          <div class="step-still">
            <div class="step-ph">
              <Phone msgs={sceneMsgs(i)} label={`Example: the customer's phone during scene ${i + 1}`} />
              {i === 4 && (
                <div class="staff">
                  <span class="staff-ic"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v7l4 2" fill="none" stroke="#2b1b17" stroke-width="2" stroke-linecap="round"/></svg></span>
                  <div><strong>{staffNote.who}</strong><p>{staffNote.text}</p></div>
                </div>
              )}
            </div>
            <CodeBlock code={panelCode(s.panel).code} lang={panelCode(s.panel).lang} title={panelCode(s.panel).title} hl={uniq([...s.hl[0], ...s.hl[1]])} />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { shouldAnimate } from "../lib/runtime";
  type S = { title: string; when: string; key: string; panel: string; hl: [number[], number[]]; clock: number; day: number };
  const root = document.querySelector<HTMLElement>(".story");
  if (root && shouldAnimate()) {
    root.classList.add("story--live");
    const scenes: S[] = JSON.parse(root.dataset.scenes || "[]");
    const steps = [...root.querySelectorAll<HTMLElement>(".step")];
    const stage = root.querySelector<HTMLElement>(".stage")!;
    const thread = stage.querySelector<HTMLElement>(".ph-thread")!;
    const view = stage.querySelector<HTMLElement>(".ph-view")!;
    const anim = [...stage.querySelectorAll<HTMLElement>("[data-at]")];
    const panels = [...stage.querySelectorAll<HTMLElement>(".stage-panel")];
    const staff = stage.querySelector<HTMLElement>(".stage-phone .staff")!;
    const dots = [...stage.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const whens = [...stage.querySelectorAll<HTMLElement>(".stage-when")];
    const capI = stage.querySelector<HTMLElement>(".stage-i")!;
    const capTitle = stage.querySelector<HTMLElement>(".stage-title")!;
    const capKey = stage.querySelector<HTMLElement>(".stage-key")!;
    const hHand = stage.querySelector<SVGElement>(".clk-h")!;
    const mHand = stage.querySelector<SVGElement>(".clk-m")!;
    let cur = "";

    const apply = (i: number, phase: number) => {
      const key = `${i}.${phase}`;
      if (key === cur) return;
      cur = key;
      const s = scenes[i];
      const v = i + phase / 2;
      stage.dataset.scene = String(i);
      steps.forEach((st, n) => st.classList.toggle("is-cur", n === i));
      for (const el of anim) el.classList.toggle("ph-on", Number(el.dataset.at) <= v);
      staff.classList.toggle("is-on", v >= 4.5);
      for (const p of panels) {
        const on = p.dataset.panel === s.panel;
        p.classList.toggle("is-on", on);
        p.inert = !on;
        if (!on) continue;
        const lines = [...p.querySelectorAll<HTMLElement>(".line")];
        const hl = s.hl[phase];
        lines.forEach((l, n) => l.classList.toggle("hl", hl.includes(n + 1)));
        const first = lines[hl[0] - 1];
        const pre = p.querySelector<HTMLElement>("pre");
        if (first && pre && pre.scrollHeight > pre.clientHeight + 4) {
          pre.scrollTo({ top: Math.max(0, first.offsetTop - pre.clientHeight / 3), behavior: "smooth" });
        }
      }
      // Keep the newest visible message at the bottom of the phone.
      const shown = anim.filter((el) => el.classList.contains("ph-a") && el.classList.contains("ph-on"));
      const last = shown[shown.length - 1];
      if (last) {
        const bottom = last.offsetTop + last.offsetHeight + 16;
        thread.style.transform = `translateY(${Math.min(0, view.clientHeight - bottom)}px)`;
      }
      for (const w of whens) w.textContent = s.when;
      capI.textContent = String(i + 1);
      capTitle.textContent = s.title;
      capKey.textContent = s.key;
      dots.forEach((d, n) => (n === i ? d.setAttribute("aria-current", "step") : d.removeAttribute("aria-current")));
      // The clock runs forward through the week: extra turns for each day passed.
      const mins = s.clock;
      mHand.style.transform = `rotate(${(mins % 60) * 6 + s.day * 720 + Math.floor(mins / 60) * 360}deg)`;
      hHand.style.transform = `rotate(${(mins / 60) * 30 + s.day * 360}deg)`;
    };

    let ticking = false;
    const measure = () => {
      ticking = false;
      const mid = window.innerHeight * 0.55;
      let idx = 0;
      let t = 0;
      steps.forEach((st, n) => {
        const r = st.getBoundingClientRect();
        if (r.top < mid) {
          idx = n;
          t = Math.min(1, Math.max(0, (mid - r.top) / r.height));
        }
      });
      apply(idx, t > 0.42 ? 1 : 0);
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(measure); }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => { cur = ""; onScroll(); });
    dots.forEach((d) => d.addEventListener("click", () => {
      const st = steps[Number(d.dataset.go)];
      const y = st.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.3;
      window.scrollTo({ top: y, behavior: "smooth" });
    }));
    apply(0, 0);
    measure();
  }
</script>

<style>
  .story { padding: 112px 0 40px; background: linear-gradient(var(--paper), var(--blush-soft) 18%, var(--blush-soft) 92%, var(--paper)); }
  .story-head { display: grid; gap: 16px; justify-items: start; margin-bottom: 56px; }
  .story-head h2 { font-size: clamp(34px, 5vw, 60px); max-width: 18ch; }
  .story-head p { max-width: 58ch; color: var(--muted); font-size: 18px; }

  /* Still layout (default): each scene with phone and code side by side. */
  .stage { display: none; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 72px; }
  .step { display: grid; gap: 28px; }
  .step-num { font: 500 14px/1.4 var(--font-mono); color: var(--brass-ink); letter-spacing: 0.02em; }
  .step h3 { font-size: clamp(26px, 3vw, 36px); margin: 10px 0 12px; }
  .step-text > p:not(.step-num) { max-width: 52ch; }
  .step-meta { margin-top: 14px !important; display: flex; gap: 6px; flex-wrap: wrap; }
  .step-meta code { margin-right: 6px; }
  .step-key { margin-top: 10px !important; font-size: 15.5px; color: var(--muted); padding-left: 14px; border-left: 2px solid var(--brass); }
  .step-still { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 28px; align-items: start; }
  .step-ph { display: grid; gap: 16px; justify-items: center; }
  .step-ph :global(.ph) { --ph-w: 280px; aspect-ratio: auto; min-height: 340px; }
  @media (min-width: 1100px) {
    .step { grid-template-columns: 340px minmax(0, 1fr); align-items: start; }
  }
  @media (max-width: 700px) {
    .step-still { grid-template-columns: minmax(0, 1fr); }
  }

  /* Live layout: pinned stage, steps scroll past it. */
  :global(.story--live) .step-still { display: none; }
  :global(.story--live) .stage { display: grid; }
  :global(.story--live) .story-body { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 48px; }
  :global(.story--live) .steps { grid-column: 1; grid-row: 1; gap: 0; }
  :global(.story--live) .step { min-height: 92vh; align-content: center; padding: 10vh 0; }
  :global(.story--live) .step-text { opacity: 0.35; transition: opacity 400ms var(--ease); }
  .stage {
    grid-column: 2; grid-row: 1; position: sticky; top: calc(var(--header-h) + 20px); align-self: start;
    height: calc(100vh - var(--header-h) - var(--bar-h) - 40px); min-height: 520px;
    grid-template-columns: auto minmax(0, 1fr); gap: 32px; align-items: center;
  }
  .stage-cap { display: none; }
  .stage-phone { position: relative; height: 100%; max-height: 620px; display: grid; align-items: center; }
  .stage-phone :global(.ph) { height: min(100%, 600px); width: auto; --ph-w: auto; }
  .stage-phone .staff { position: absolute; right: -40px; top: 18%; opacity: 0; transform: translateY(-10px) scale(0.96); transition: opacity 400ms var(--ease), transform 500ms var(--ease); z-index: 2; max-width: 250px; }
  .stage-phone .staff:global(.is-on) { opacity: 1; transform: none; }
  .stage-side { display: grid; gap: 16px; align-content: center; min-width: 0; }
  .stage-clock { display: inline-flex; align-items: center; gap: 12px; font: 500 15px/1 var(--font-mono); color: var(--espresso); }
  .clk-h, .clk-m { stroke: var(--espresso); stroke-width: 2.6; stroke-linecap: round; transform-box: view-box; transform-origin: 20px 20px; transition: transform 1.1s var(--ease-swing); }
  .clk-m { stroke: var(--brass-ink); stroke-width: 2; }
  .stage-code { display: grid; min-width: 0; }
  .stage-panel { grid-area: 1 / 1; opacity: 0; transform: translateY(8px); transition: opacity 360ms var(--ease), transform 420ms var(--ease); min-width: 0; }
  .stage-panel.is-on { opacity: 1; transform: none; }
  .stage-panel :global(pre) { white-space: pre-wrap; font-size: 13.5px; max-height: 46vh; overflow-y: auto; }
  .stage-panel :global(pre code) { min-width: 0; }
  .stage-panel :global(.line) { transition: background 300ms var(--ease), box-shadow 300ms var(--ease), opacity 300ms; }
  .stage-panel :global(.line:not(.hl)) { opacity: 0.62; }
  .stage-panel :global(.line.hl) { opacity: 1; animation: line-in 520ms var(--ease) both; }
  @keyframes line-in { from { box-shadow: inset 0 0 0 var(--brass); background: rgba(184, 138, 68, 0); } }
  .stage-dots { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .stage-dots button { width: 44px; height: 44px; border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; }
  .stage-dots button::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); transition: background 300ms, transform 300ms var(--ease); }
  .stage-dots button[aria-current]::before { background: var(--brass); transform: scale(1.35); }

  :global(.story--live) .step:global(.is-cur) .step-text { opacity: 1; }

  /* Phone layout: one pinned stage, one caption swapped per scene. */
  @media (max-width: 820px) {
    :global(.story--live) .story-body { display: block; }
    :global(.story--live) .stage {
      top: var(--header-h); height: calc(100svh - var(--header-h) - var(--bar-h)); min-height: 0;
      grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr) auto; gap: 10px; padding: 10px 0 12px;
      align-items: stretch;
    }
    :global(.story--live) .steps { margin-top: calc(-1 * (100svh - var(--header-h) - var(--bar-h))); position: relative; pointer-events: none; }
    :global(.story--live) .step { min-height: 100svh; padding: 0; }
    :global(.story--live) .step-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .stage-cap { display: block; }
    .stage-num { font: 500 13px/1.3 var(--font-mono); color: var(--brass-ink); }
    .stage-title { font: 500 22px/1.15 var(--font-display); margin-top: 4px; }
    .stage-key { font-size: 14.5px; color: var(--muted); margin-top: 4px; line-height: 1.35; }
    .stage-phone { height: 100%; max-height: none; justify-items: center; min-height: 0; }
    .stage-phone :global(.ph) { height: 100%; max-height: 430px; border-radius: 30px; padding: 8px; box-shadow: 0 0 0 7px var(--espresso), 0 20px 40px -20px rgba(43, 27, 23, 0.45); }
    .stage-phone :global(.ph-top) { padding: 6px 6px 8px; }
    .stage-phone :global(.ph-input) { display: none; }
    .stage-phone :global(.ph-m) { font-size: 13.5px; }
    .stage-phone .staff { right: 0; left: auto; top: auto; bottom: 8px; max-width: 220px; padding: 10px 12px; }
    .stage-phone .staff p { font-size: 13px; }
    .stage-side { gap: 6px; }
    .stage-clock, .stage-dots { display: none; }
    .stage-panel :global(pre) { max-height: 22svh; font-size: 12.5px; padding: 10px 14px 12px; }
    .stage-panel :global(.cb-bar) { padding-left: 12px; }
    .stage-panel :global(.cb-copy) { min-height: 44px; }
  }
</style>
