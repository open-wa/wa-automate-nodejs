---
/**
 * The composer pinned to the bottom of the agent window. It holds the thing
 * to copy: the Easy API run command by default, with tabs for the MCP config
 * (wa.config.mjs plus its start command) and the Claude Desktop config.
 * Tabs follow the ARIA pattern: arrow keys move, Home and End jump.
 */
import CodeBlock from "./CodeBlock.astro";
import { commands, snippets, href } from "../data/site";
const run = commands.easyApi;
const [bin, ...rest] = run.split(" ");
---

<div class="cmp" data-composer>
  <div class="cmp-head">
  <div class="cmp-tabs" role="tablist" aria-label="What to copy">
    <button role="tab" id="cmp-t-run" aria-controls="cmp-p-run" aria-selected="true" tabindex="0" type="button">Command</button>
    <button role="tab" id="cmp-t-mcp" aria-controls="cmp-p-mcp" aria-selected="false" tabindex="-1" type="button">MCP config</button>
    <button role="tab" id="cmp-t-claude" aria-controls="cmp-p-claude" aria-selected="false" tabindex="-1" type="button">Claude Desktop</button>
  </div>
  <span class="cmp-keys" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd> switch</span>
  </div>

  <div class="cmp-panel" role="tabpanel" id="cmp-p-run" aria-labelledby="cmp-t-run">
    <div class="cmp-field">
      <code class="cmp-cmd"><span class="cmp-prompt" aria-hidden="true">$</span><span class="cmp-bin">{bin}</span> {rest.map((w) => <><span class="cmp-w">{w}</span>{" "}</>)}</code>
      <button class="cmp-copy" type="button" data-copy={run} aria-label="Copy the run command">
        <span class="cmp-copy-idle">Copy</span><span class="cmp-copy-done" aria-hidden="true">Copied</span>
      </button>
    </div>
    <p class="cmp-note">Starts a local API on port 8080 and prints a QR code to scan.</p>
  </div>

  <div class="cmp-panel" role="tabpanel" id="cmp-p-mcp" aria-labelledby="cmp-t-mcp" hidden>
    <CodeBlock code={snippets.mcpConfig} lang="js" title="wa.config.mjs" />
    <CodeBlock code={snippets.mcpStart} lang="bash" title="Start it" class="cmp-gap" />
    <p class="cmp-note">The MCP endpoint is <code>{commands.mcpEndpoint}</code>. <a class="textlink" href={href("ai-agents/")}>Agent set-up</a></p>
  </div>

  <div class="cmp-panel" role="tabpanel" id="cmp-p-claude" aria-labelledby="cmp-t-claude" hidden>
    <CodeBlock code={snippets.claudeDesktop} lang="json" title="Claude Desktop config" />
    <p class="cmp-note">Use the same key you started the API with. Cursor and Windsurf take the same URL and header.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-composer]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const n = tabs.length;
        const to = e.key === "ArrowRight" ? (i + 1) % n : e.key === "ArrowLeft" ? (i - 1 + n) % n : e.key === "Home" ? 0 : e.key === "End" ? n - 1 : -1;
        if (to < 0) return;
        e.preventDefault();
        select(tabs[to]);
      });
    });
  });
</script>

<style>
  .cmp { display: grid; gap: 10px; min-width: 0; }
  .cmp-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; }
  .cmp-keys { display: inline-flex; align-items: center; gap: 4px; font: 400 13px/1 var(--font-mono); color: var(--ink-faint); white-space: nowrap; }
  @media (max-width: 1100px), (pointer: coarse) { .cmp-keys { display: none; } }
  .cmp-tabs {
    display: flex; gap: 4px; padding: 4px; width: fit-content; max-width: 100%; overflow-x: auto;
    background: var(--bone-deep); border-radius: 999px;
  }
  .cmp-tabs button {
    flex: none; min-height: 40px; padding: 0 14px; border: 0; border-radius: 999px;
    background: transparent; color: var(--ink-soft); font: 500 15px/1 var(--font-text); cursor: pointer;
    transition: background var(--speed) var(--ease), color var(--speed);
  }
  .cmp-tabs button:hover { color: var(--ink); }
  .cmp-tabs button[aria-selected="true"] { background: var(--paper); color: var(--ink); box-shadow: 0 1px 2px rgba(60, 30, 20, 0.18); }
  .cmp-panel { min-width: 0; }
  .cmp-panel :global(.cmp-gap) { margin-top: 8px; }
  .cmp-panel :global(.cb pre) { font-size: 13.5px; padding: 12px 14px; }

  .cmp-field {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 8px 8px 16px; min-height: 64px;
    background: var(--paper); border: 1.5px solid var(--ink); border-radius: 16px;
    box-shadow: 0 2px 0 var(--ink);
  }
  .cmp-cmd {
    flex: 1; min-width: 0; background: none !important; padding: 0 !important;
    font: 500 16px/1.45 var(--font-mono) !important; color: var(--ink); overflow-wrap: anywhere;
  }
  .cmp-prompt { color: var(--oxblood); margin-right: 0.6em; user-select: none; }
  .cmp-bin { color: var(--oxblood); font-weight: 600; }
  .cmp-copy {
    position: relative; flex: none; display: inline-grid; place-items: center;
    min-height: 46px; min-width: 92px; padding: 0 16px; border: 0; border-radius: 11px;
    background: var(--oxblood); color: #fff8f0; font: 600 16px/1 var(--font-text); cursor: pointer;
    transition: background var(--speed) var(--ease), transform 120ms;
  }
  .cmp-copy:hover { background: var(--oxblood-deep); }
  .cmp-copy:active { transform: scale(0.97); }
  .cmp-copy > span { grid-area: 1 / 1; transition: opacity 160ms, transform 220ms var(--ease); }
  .cmp-copy-done { opacity: 0; transform: translateY(6px); }
  .cmp-copy[data-state="copied"] { background: var(--ink); }
  .cmp-copy[data-state="copied"] .cmp-copy-idle { opacity: 0; transform: translateY(-6px); }
  .cmp-copy[data-state="copied"] .cmp-copy-done { opacity: 1; transform: none; }
  .cmp-w { white-space: nowrap; }
  @media (max-width: 520px) {
    .cmp-field { flex-wrap: wrap; padding: 12px 8px 8px 14px; gap: 8px; }
    .cmp-cmd { flex-basis: 100%; font-size: 15px !important; }
    .cmp-copy { margin-left: auto; min-width: 110px; }
    .cmp-tabs button { padding: 0 11px; }
  }
  .cmp-note { margin-top: 8px; font-size: 15px; color: var(--ink-soft); }
</style>
